<title>Finper</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap">
<style>
  :root{
    --bg:#10141b; --card:#1c222b; --card-2:#171d26; --line:#2d333d;
    --ink:#e4e8ef; --ink-soft:#9199a5; --ink-bright:#f0f2f5;
    --accent:#c295ff; --accent-bg:#33244b; --accent-ink:#140f1e;
    --in:#5ce483; --in-bg:#0d371a;
    --out:#f75b6b; --out-bg:#4b1d20;
    --inv:#3bcddc; --track:#282e38;
    --r:12px; --r-sm:8px;
    --sans:'Work Sans',system-ui,-apple-system,sans-serif;
    --display:'Sora','Work Sans',system-ui,sans-serif;
    --mono:'JetBrains Mono',ui-monospace,'SFMono-Regular',monospace;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  /* Interlineado: hasta la v32 no había ninguno declarado, así que todo heredaba el "normal"
     del navegador (~1,2), que es un valor de titular aplicado a texto corrido. La regla es que
     el aire baja a medida que sube el tamaño: el texto chico necesita proporcionalmente más.
     Valores de la v32, por si hay que volver: texto 1,45 · chico 1,5 · títulos 1,25 · cifras 1,2.
     Los de acá son esos mismos con un 15% más. */
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-weight:500;margin:0;
       line-height:1.67;overscroll-behavior-y:contain}
  .h,.sechead,h2,h3{line-height:1.44}
  .tiny{line-height:1.72}
  #app{max-width:440px;margin:0 auto;min-height:100svh;height:100svh;display:flex;flex-direction:column;
       background:var(--bg);position:relative;overflow:hidden}
  @media (min-width:520px){ #app{border-left:1px solid var(--line);border-right:1px solid var(--line)} }

  .num{font-family:var(--mono);font-variant-numeric:tabular-nums}
  .h{font-family:var(--display);font-weight:600}
  button{font:inherit;color:inherit;background:none;border:none;padding:0;cursor:pointer}
  button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  input,select{font:inherit;color:var(--ink);background:var(--card);border:1px solid var(--line);
       border-radius:var(--r-sm);padding:10px 12px;font-size:16px;min-height:44px;width:100%;
       min-width:0;max-width:100%}
  input[type="date"]{-webkit-appearance:none;appearance:none}
  input::placeholder{color:var(--ink-soft)}
  select{appearance:none}
  .muted{color:var(--ink-soft)}
  .tiny{font-size:11px}

  /* header */
  header{display:flex;align-items:center;justify-content:space-between;gap:10px;
       padding:max(14px,env(safe-area-inset-top)) 16px 12px;border-bottom:1px solid var(--line);flex:none}
  .brand{display:flex;align-items:center;gap:8px}
  .badge{background:var(--card);border:1px solid var(--line);border-radius:var(--r-sm);padding:7px 11px;text-align:right}
  .badge .lbl{font-size:10px;color:var(--ink-soft);white-space:nowrap;letter-spacing:.04em;text-transform:uppercase}
  .badge .val{font-family:var(--mono);font-weight:700;font-size:15px;line-height:1.3}

  /* view */
  #view{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch}
  /* el botón flotante del chat se apoya sobre el final de la pantalla:
     este aire de más deja que lo último de la lista se pueda leer completo */
  .pad{padding:16px 16px 42px}
  #chatlist{padding-bottom:8px}
  .stack{display:flex;flex-direction:column}

  /* chat */
  #chatlist{display:flex;flex-direction:column;gap:10px;padding:16px}
  .bub{max-width:86%;padding:10px 13px;font-size:14px;line-height:1.45;border-radius:var(--r)}
  .me{align-self:flex-end;background:var(--accent);color:var(--accent-ink);font-weight:600;
      border-bottom-right-radius:3px}
  .bot{align-self:flex-start;background:var(--card);border:1px solid var(--line);border-bottom-left-radius:3px}
  .row{display:flex;align-items:flex-start;gap:10px}
  .ico{width:26px;height:26px;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;flex:none}
  .dot{width:7px;height:7px;border-radius:2px;display:inline-block;vertical-align:middle}
  .pencil{flex:none;padding:6px;margin:-6px -4px -6px 0;color:var(--ink-soft)}
  .chips{display:flex;flex-wrap:wrap;gap:7px;padding:4px 16px 16px}
  .chip{border:1px solid var(--line);background:var(--card);border-radius:var(--r-sm);padding:8px 11px;
       font-size:12.5px;text-align:left;min-height:40px}
  .chip.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:600}
  .opt{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%}
  .opt-main{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .opt-meta{flex:none;font-size:11.5px;color:var(--ink-soft);white-space:nowrap}
  .chip.on .opt-meta{color:var(--accent-ink);opacity:.7}
  .chip.danger{color:var(--out)}
  .solid{background:var(--accent);color:var(--accent-ink);border-radius:var(--r-sm);padding:9px 14px;
       font-weight:600;font-size:13px;min-height:40px}

  /* composer */
  #composer{display:flex;gap:8px;align-items:center;padding:10px 12px 26px;border-top:1px solid var(--line);flex:none}
  #composer[hidden]{display:none}
  #msg{flex:1}
  #send{width:44px;height:44px;flex:none;border-radius:var(--r-sm);background:var(--accent);
       display:flex;align-items:center;justify-content:center}
  #send[disabled]{opacity:.45}

  /* tabbar */
  nav{display:flex;border-top:1px solid var(--line);background:var(--card-2);flex:none;
      padding-bottom:env(safe-area-inset-bottom);position:relative}
  nav button{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:4px;padding:9px 0 10px;
      color:var(--ink-soft);font-size:10px;font-weight:600;letter-spacing:-.01em}
  /* El chat es la acción principal, así que sale de la barra como el botón de una billetera */
  .tab-chat{position:relative}
  .tab-chat .hueco{height:19px}
  .fab{position:absolute;left:50%;top:-17px;transform:translateX(-50%);width:50px;height:50px;
      border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;
      box-shadow:0 5px 16px rgba(0,0,0,.5)}
  nav button[aria-current="page"]{color:var(--accent);font-weight:700}

  /* blocks */
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:13px 14px}
  .sechead{font-family:var(--display);font-weight:600;font-size:13.5px;margin:0 0 10px}
  .monthnav{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .monthnav button{padding:8px;color:var(--ink-soft)}
  .monthnav .h{font-size:15px}
  .leader{display:flex;align-items:baseline;gap:6px;font-size:13px;padding:3px 0}
  .leader .fill{flex:1;border-bottom:1px dotted var(--line);margin-bottom:4px;min-width:8px}
  .bar{height:6px;background:var(--track);border-radius:3px;overflow:hidden;margin-top:5px}
  .bar3{display:flex;height:11px;background:var(--track);border-radius:6px;overflow:hidden;margin-top:6px}
  .bar3 span{display:block;height:100%;min-width:0}
  /* Lo estimado va rayado a propósito: que se vea de lejos qué parte de la barra es un
     supuesto y cuál es plata que ya se movió. */
  .est{background-image:repeating-linear-gradient(135deg,
     rgba(255,255,255,.34) 0 3px, rgba(255,255,255,0) 3px 7px)}
  .pnota{font-size:12px;line-height:1.6;color:var(--ink-soft)}
  .bar > i{display:block;height:100%;border-radius:3px}
  /* Sin objetivo definido no hay proporción que mostrar: una barra llena mentiría */
  .bar.sin-meta{background:transparent;border:1px dashed var(--line);height:6px}
  /* el recorte es lo que deja animar la altura sin que el contenido se derrame */
  .cat-det{overflow:hidden}
  .grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px}
  .stat .lbl{font-size:10px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
  .stat .val{font-family:var(--mono);font-weight:700;font-size:17px;line-height:1.38}
  .donutwrap{display:flex;justify-content:center}
  .donut{position:relative;width:min(224px,62vw);aspect-ratio:1;flex:none}
  .donut svg{width:100%;height:100%}
  .seg-arco{cursor:pointer;transition:opacity .16s ease,stroke-width .16s ease}
  /* el anillo visible tiene 13 de grosor; el aro de toque, 24, para que no haya que apuntar */
  .aro-toque{cursor:pointer;pointer-events:stroke}
  @media (prefers-reduced-motion:reduce){ .seg-arco{transition:none} }
  /* con una porción elegida, las demás se corren a un segundo plano */
  .donut svg.hay-sel .seg-arco{opacity:.28}
  .donut svg.hay-sel .seg-arco.sel{opacity:1;stroke-width:17}
  .donut .hole{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
       justify-content:center;gap:1px;pointer-events:none}
  .legend{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
  .legend .it{display:flex;align-items:center;gap:7px;font-size:12px;min-width:0}
  .mvrow{display:flex;align-items:center;gap:10px;font-size:13px;padding:9px 0;border-bottom:1px solid var(--line)}
  .mvrow .d{color:var(--ink-soft);flex:none;width:38px;font-family:var(--mono);font-size:12px}
  .mvrow .t{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .empty{text-align:center;color:var(--ink-soft);font-size:13.5px;line-height:1.6;padding:32px 8px}
  .field{display:flex;flex-direction:column;gap:5px}
  .field label{font-size:11px;color:var(--ink-soft)}
  .objrow{display:flex;align-items:center;gap:8px}
  .objrow .nm{flex:1;font-size:13px}
  .objrow input{width:62px;text-align:right;padding:7px 9px;min-height:38px}
  .objrow input.obj-monto{width:112px;font-family:var(--mono)}
  /* al alto de la fila y ancho suficiente para el dedo: 26px era un blanco muy chico */
  .obj-modo{width:36px;min-height:38px;flex:none;border-radius:var(--r-sm);background:var(--card);
       border:1px solid var(--line);color:var(--ink-soft);font-size:13px;font-weight:700}
  .obj-modo:active{background:var(--accent-bg);color:var(--accent)}
  .banner{background:var(--out-bg);border:1px solid var(--out);color:var(--ink);
       border-radius:var(--r-sm);padding:9px 12px;font-size:12.5px;line-height:1.45;margin:12px 16px 0}
  svg{display:block}
  @media (prefers-reduced-motion:no-preference){
    .bar > i{transition:width .35s ease}
  }

  /* menú lateral */
  .brand{display:flex;align-items:center;gap:8px;padding:6px 8px 6px 0;margin-left:-2px;border-radius:var(--r-sm)}
  .brand .chev{color:var(--ink-soft);transition:transform .2s ease}
  .brand[aria-expanded="true"] .chev{transform:rotate(90deg)}
  .albolita{width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none;
    align-self:flex-start;margin:6px 0 0 -4px}
  .albox{width:20px;height:20px;border-radius:6px;border:1.6px solid var(--line);flex:none;
    display:flex;align-items:center;justify-content:center;color:var(--accent-ink)}
  button[aria-pressed="true"]>.albox{background:var(--accent);border-color:var(--accent)}
  #scrim{position:absolute;inset:0;z-index:20;background:rgba(3,5,9,.66);opacity:0;transition:opacity .2s ease}
  #scrim.on{opacity:1}
  #scrim[hidden]{display:none}
  #drawer{position:absolute;top:0;bottom:0;left:0;z-index:21;width:min(312px,86%);
       background:var(--card-2);border-right:1px solid var(--line);box-shadow:14px 0 40px rgba(0,0,0,.45);
       transform:translateX(-102%);transition:transform .24s cubic-bezier(.2,.7,.2,1);
       display:flex;flex-direction:column;overflow-y:auto;-webkit-overflow-scrolling:touch}
  #drawer.on{transform:translateX(0)}
  #drawer[hidden]{display:none}
  @media (prefers-reduced-motion:reduce){ #drawer,#scrim,.brand .chev{transition:none} }
  .dw-top{padding:max(16px,env(safe-area-inset-top)) 14px 4px;display:flex;flex-direction:column;gap:13px}
  .dw-cards{display:flex;flex-direction:column;gap:9px}
  .dw-card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:11px 12px;
       display:flex;align-items:center;gap:11px}
  .dw-card .k{font-size:10px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.05em}
  .dw-card .v{font-family:var(--mono);font-weight:700;font-size:16px;line-height:1.25}
  .dw-card .sub{font-size:11px;color:var(--ink-soft)}
  .dw-ring{width:38px;height:38px;flex:none}
  .dw-group{padding:14px 14px 0}
  .dw-group h3{font-size:10px;font-weight:700;color:var(--ink-soft);text-transform:uppercase;
       letter-spacing:.11em;margin:0 0 4px;padding:0 8px}
  .dw-item{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:11px 8px;
       border-radius:var(--r-sm);font-size:14px;min-height:44px;color:var(--ink)}
  .dw-item svg{color:var(--ink-soft);flex:none}
  .dw-item:active{background:var(--card)}
  .dw-item[aria-current="page"]{background:var(--accent-bg);color:var(--accent);font-weight:600}
  .dw-item[aria-current="page"] svg{color:var(--accent)}
  .dw-foot{margin-top:auto;padding:16px 22px max(18px,env(safe-area-inset-bottom));font-size:11px;color:var(--ink-soft);line-height:1.5}
  /* pantalla de bienvenida: el trazo del logo se dibuja y después aparece el nombre */
  #splash{position:absolute;inset:0;z-index:40;background:var(--bg);display:flex;flex-direction:column;
       align-items:center;justify-content:center;gap:20px;transition:opacity .28s ease}
  #splash.gone{opacity:0;pointer-events:none}
  #splash[hidden]{display:none}
  .fp-draw{stroke-dasharray:420;stroke-dashoffset:420;animation:fp-draw 1.1s cubic-bezier(.4,0,.2,1) forwards}
  .fp-draw-2{animation-delay:.55s}
  .fp-draw-3{animation-delay:.35s;animation-duration:1.3s}
  @keyframes fp-draw{ to{ stroke-dashoffset:0 } }
  /* Dos cosas medidas en pantalla, no calculadas a ojo: el interletrado está elegido para
     que FINPER mida exactamente lo mismo que el monograma de arriba (los bordes coinciden),
     y el padding compensa el espacio que letter-spacing agrega también DESPUÉS de la última
     letra, que si no deja la palabra corrida a la izquierda. Si se cambia el tamaño o la
     tipografía, hay que volver a medirlo. */
  .fp-name{font-family:var(--display);font-weight:700;text-transform:uppercase;letter-spacing:.36em;
       padding-left:.29em;
       color:var(--ink-bright);font-size:20px;opacity:0;animation:fp-in .6s ease forwards;animation-delay:1.45s}
  @keyframes fp-in{ to{ opacity:1 } }
  @media (prefers-reduced-motion:reduce){
    .fp-draw{stroke-dashoffset:0;animation:none}
    .fp-name{opacity:1;animation:none}
    #splash{transition:none}
  }
  .seg{display:flex;gap:4px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:3px}
  .seg button{flex:1;padding:8px 6px;border-radius:7px;font-size:12.5px;font-weight:600;color:var(--ink-soft);min-height:38px}
  .seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
  .dw-badge{margin-left:auto;background:var(--accent);color:var(--accent-ink);font-family:var(--mono);
       font-size:10.5px;font-weight:700;min-width:19px;height:19px;border-radius:10px;
       display:flex;align-items:center;justify-content:center;padding:0 5px;flex:none}
</style>

<div id="app">
  <header>
    <button class="brand" id="menubtn" aria-expanded="false" aria-controls="drawer" aria-label="Abrir menú">
      <svg width="37" height="22" viewBox="0 0 252 150" fill="none" aria-hidden="true">
        <defs><linearGradient id="lg" x1="0" y1="0" x2="252" y2="150" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#c295ff"/><stop offset="1" stop-color="#5ce483"/></linearGradient></defs>
        <path d="M36 138V26Q36 12 50 12h54" stroke="url(#lg)" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M36 80h48" stroke="url(#lg)" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M156 138V26q0-14 14-14h18q28 0 28 30t-28 30h-24" stroke="url(#lg)" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      <span class="albolita" id="albolita" hidden></span>
    </button>
    <button class="badge" id="badge" aria-label="Cambiar la moneda en la que se ven los saldos">
      <div class="lbl" id="badge-lbl">Saldo del mes</div>
      <div class="val num" id="saldo">—</div>
    </button>
  </header>

  <div id="banner-slot"></div>
  <div id="view"></div>

  <div id="composer" hidden>
    <input id="msg" type="text" autocomplete="off" autocapitalize="sentences"
           placeholder="Escribí un movimiento… ej: pagué 8500 de luz">
    <button id="send" aria-label="Enviar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#140f1e" stroke-width="2.4"
           stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 5l7 7-7 7"/></svg>
    </button>
  </div>

  <nav id="tabs">
    <button data-tab="resumen">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      Resumen</button>
    <button data-tab="actividad">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg>
      Actividad</button>
    <button data-tab="chat" class="tab-chat">
      <span class="fab" aria-hidden="true">
        <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="var(--accent-ink)" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4V5z"/></svg>
      </span>
      <span class="hueco"></span>
      Chat</button>
    <button data-tab="historial">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg>
      Historial</button>
    <button data-tab="config">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2.2" fill="var(--card-2)"/>
        <circle cx="15" cy="12" r="2.2" fill="var(--card-2)"/><circle cx="7" cy="18" r="2.2" fill="var(--card-2)"/></svg>
      Config</button>
  </nav>

  <div id="scrim" hidden></div>
  <aside id="drawer" hidden aria-label="Menú de Finper"></aside>

  <div id="splash" role="status" aria-label="Finper está abriendo">
    <svg width="146" height="87" viewBox="0 0 252 150" fill="none" aria-hidden="true">
      <defs><linearGradient id="lgs" x1="0" y1="0" x2="252" y2="150" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#c295ff"/><stop offset="1" stop-color="#5ce483"/></linearGradient></defs>
      <path class="fp-draw" d="M36 138 V26 Q36 12 50 12 H104" stroke="url(#lgs)" stroke-width="20"
        stroke-linecap="round" stroke-linejoin="round"/>
      <path class="fp-draw fp-draw-2" d="M36 80 H84" stroke="url(#lgs)" stroke-width="20"
        stroke-linecap="round" stroke-linejoin="round"/>
      <path class="fp-draw fp-draw-3" d="M156 138 V26 Q156 12 170 12 H188 Q216 12 216 42 Q216 72 188 72 H164"
        stroke="url(#lgs)" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <div class="fp-name">Finper</div>
  </div>
</div>

<script>
"use strict";

/* ===================== dominio ===================== */

const CATEGORIAS_GASTO = ["Vivienda","Servicios","Supermercado","Almacén/Kiosco","Transporte","Salud",
  "Entretenimiento y ocio","Educación","Indumentaria","Cuidado personal","Mascotas","Regalos / eventos",
  "Suscripciones","Préstamos y cuotas","Otros"];

const CATEGORIAS_INGRESO = ["Sueldo","Freelance / honorarios","Rentas / alquileres cobrados",
  "Intereses / rendimientos","Reembolso","Diferencia por devolución","Otros ingresos"];

/* Paleta de categorías, en dos pisos, como la pensó Franco: ocho tonos vivos para las
   primeras categorías y los MISMOS ocho tonos en versión oscura para las que siguen. No
   están elegidos a ojo: cada vivo es el punto de máximo croma que ese tono admite en sRGB
   (por eso cada uno cae a una luminosidad distinta —el amarillo alto, el azul bajo—, y esa
   variación es parte de lo que los hace vivos), y el oscuro es el mismo tono bajando la
   luminosidad, sin lavar el croma: un color lavado tiende al gris y pierde separación.

   Medido sobre el fondo (#10141b), de a TODOS los pares:
     · los 8 vivos entre sí: peor par ΔE 15,9 a simple vista — arriba del piso de 15.
     · los 16 completos: 10 pares de 120 quedan entre 12,9 y 14,4, apenas abajo del piso.
       Están listados en PARES_FLOJOS y la torta nunca los dibuja pegados.
     · contraste contra el fondo: todos ≥3:1.
     · daltonismo: el peor par queda en ΔE 2,2, muy abajo del piso de 8. No es un defecto
       de esta paleta sino del problema: con más de nueve colores no existe ninguna que
       cumpla, se buscó. Se compensa con que en la app cada color va siempre pegado al
       nombre de su categoría, y tocando una porción se lee cuál es.
   Si se tocan los colores hay que volver a medir: scripts paleta3.mjs y eval_paleta.mjs. */
const CATEGORY_COLORS = ["#fe9f00","#fe2b00","#db0aff","#00fbef","#fd009a","#009ffd","#eee000","#00ff55",
  "#ab6900","#c11c00","#a700c4","#00b3aa","#c10074","#0068a8","#aa9f00","#00b439"];
/* Pares que la torta evita dibujar pegados, por dos motivos de distinto peso:
   · los que miden abajo del piso de 15 (listados acá, como i*16+j con i<j): pegados se
     leen como una sola porción, y eso es un error de lectura.
   · los gemelos (un tono y su versión oscura, i e i+8): miden bien, pero "naranja fuerte"
     al lado de "naranja apagado" se siente como un degradé y no como dos categorías.
   El primero pesa más que el segundo: en los poquísimos repartos donde no se puede cumplir
   todo (11 de los 8.008 subconjuntos de seis colores), cede el degradé, nunca la lectura. */
const PARES_FLOJOS = new Set([14,25,42,76,137,142,156,172,191,239]);
function costoPar(a,b){
  if(a<0||b<0||a===b) return 0;
  const i=Math.min(a,b), j=Math.max(a,b);
  if(PARES_FLOJOS.has(i*16+j)) return 2;
  return j-i===8 ? 1 : 0;
}

