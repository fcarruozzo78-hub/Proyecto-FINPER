let drawerTimer=null;
function openDrawer(){
  if(drawerTimer){ clearTimeout(drawerTimer); drawerTimer=null; }
  /* Los números del panel no se animan: no son lo primero que ves al abrir la app,
     los mirás cuando ya estás adentro, y ahí un conteo solo estorba. */
  renderDrawer();
  $drawer.hidden=false; $scrim.hidden=false;
  requestAnimationFrame(()=>{ $drawer.classList.add("on"); $scrim.classList.add("on"); });
  $menubtn.setAttribute("aria-expanded","true");
  const first=$drawer.querySelector("[data-nav]");
  if(first) first.focus({preventScroll:true});
}
function closeDrawer(refocus){
  $drawer.classList.remove("on"); $scrim.classList.remove("on");
  $menubtn.setAttribute("aria-expanded","false");
  if(refocus) $menubtn.focus({preventScroll:true});
  drawerTimer=setTimeout(()=>{ $drawer.hidden=true; $scrim.hidden=true; drawerTimer=null; },240);
}
function drawerOpen(){ return $drawer.classList.contains("on"); }

function render(){
  /* La pantalla se rehace entera, así que la porción elegida del anillo deja de existir:
     si no se limpia acá, el primer toque siguiente sobre esa misma porción la "apagaría". */
  arcoSel=null;
  invalidarAlertas();
  const stats=computeMonthStats(movs(),monthKeyOf(todayISO())).ARS;
  const disp=disponibleDe(stats);
  $saldo.textContent=fmtV(disp);
  $saldo.style.color = disp<0 ? COL.out : COL.in;
  document.getElementById("badge-lbl").textContent = `Saldo del mes · ${vista()}`;

  /* Un punto al lado del logo: alcanza para saber que hay algo, sin ocupar pantalla. */
  const nAl=alertasActivas().length;
  $albolita.hidden = !nAl;
  $albolita.style.background = hayUrgente() ? COL.out : COL.acc;
  $menubtn.setAttribute("aria-label", nAl ? `Abrir menú · ${nAl} ${nAl>1?"alertas":"alerta"}` : "Abrir menú");

  document.querySelectorAll("#tabs button").forEach((b)=>{
    if(b.dataset.tab===S.tab) b.setAttribute("aria-current","page"); else b.removeAttribute("aria-current");
  });

  $composer.hidden = S.tab!=="chat";
  $send.disabled = S.isProcessing || !S.sample;
  if($msg.value!==S.draft) $msg.value=S.draft;
  $msg.placeholder = !S.sample ? "La IA no está disponible en esta vista"
    : S.pendingReembolso ? '¿De qué gasto era? (o "cancelar")'
    : "Escribí un movimiento… ej: pagué 8500 de luz";

  renderBanner();
  if(S.tab==="chat") renderChat();
  else if(S.tab==="resumen") renderResumen();
  else if(S.tab==="actividad") renderActividad();
  else if(S.tab==="fijos") renderFijos();
  else if(S.tab==="tarjetas") renderTarjetas();
  else if(S.tab==="alertas") renderAlertas();
  else if(S.tab==="proyeccion") renderProyeccion();
  else if(S.tab==="patrimonio") renderPatrimonio();
  else if(S.tab==="historial") renderHistorial();
  else renderConfig();

  /* El chat se desplaza solo hasta el último mensaje, y ese desplazamiento quedaba
     puesto al volver a otra pestaña: cada pantalla nueva arranca desde arriba. */
  if(S.entrada && S.tab!=="chat") $view.scrollTop=0;

  if(drawerOpen()) renderDrawer();

  if(S.scrollTo){
    const el=document.getElementById(S.scrollTo);
    S.scrollTo=null;
    if(el) el.scrollIntoView({block:"start",behavior:"smooth"});
  }

  const vActual=vista();
  const cambioDeMoneda = S.vistaPrev!==null && S.vistaPrev!==vActual;

  if(S.entrada){
    S.entrada=false;
    animarEntrada($view);
    /* El saldo del encabezado está siempre a la vista, así que solo cuenta desde cero
       cuando de verdad es una llegada: al abrir la app o al volver a Resumen. */
    if(animOk() && S.saldoAnim) contar($saldo,disp,"ARS",false);
    S.saldoAnim=false;
  } else if(animOk() && !cambioDeMoneda && S.saldoPrev!==null
            && Math.round(S.saldoPrev)!==Math.round(disp)){
    /* El saldo cambió por algo que hizo el usuario (cargó un movimiento, lo deshizo,
       lo editó): va del valor viejo al nuevo, más rápido que una entrada. */
    contar($saldo,disp,"ARS",false,S.saldoPrev,900,true);
  }

  S.saldoPrev=disp;
  S.vistaPrev=vActual;
}

/* El día es la unidad con la que uno se acuerda de lo que gastó ("el viernes fuimos al
   super"). Una lista corrida de treinta movimientos borra esa división: dos compras del 12 y
   una del 13 se leen como una sola tanda. */
function diaLabel(iso){
  const hoy=todayISO();
  const ayer=new Date(new Date(hoy+"T00:00:00Z").getTime()-86400000).toISOString().slice(0,10);
  if(iso===hoy) return `Hoy · ${formatFecha(iso)}`;
  if(iso===ayer) return `Ayer · ${formatFecha(iso)}`;
  const dias=["Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"];
  return `${dias[new Date(iso+"T00:00:00Z").getUTCDay()]} ${formatFecha(iso)}`;
}
/* Cada día lleva al costado lo que se gastó ese día: es la pregunta que uno se hace mirando
   la fecha, y ya está todo acá como para tener que sumarlo a ojo. */
function cabeceraDia(iso,items,primero){
  const gasto=items.reduce((a,t)=>a+(t.tipo==="gasto"?netoDe(t):0),0);
  return `<div style="display:flex;align-items:baseline;gap:9px;margin:${primero?"2px":"15px"} 0 3px">
    <span class="h" style="font-size:12.5px">${esc(diaLabel(iso))}</span>
    <span style="flex:1;height:1px;background:var(--line)"></span>
    ${gasto>0?`<span class="tiny muted">gastos <span class="num">${esc(shortV(gasto))}</span></span>`:""}
  </div>`;
}
function porDia(list){
  const orden=[], g={};
  list.forEach((t)=>{ if(!g[t.fecha]){ g[t.fecha]=[]; orden.push(t.fecha); } g[t.fecha].push(t); });
  return orden.map((fecha,i)=>cabeceraDia(fecha,g[fecha],i===0)
    + `<div>${g[fecha].map((t)=>movRow(t,false,true)).join("")}</div>`).join("");
}

function movRow(t,sinCat,sinFecha){
  const editing = !t.virtual && S.editingId===("tx:"+t.id) && S.editForm;
  /* Una cuota no se edita sola: se edita la compra que la generó. */
  const lapiz = t.virtual
    ? `<button class="pencil" data-act="cp-edit" data-id="${esc(t.compraId)}" aria-label="Editar la compra">${PENCIL}</button>`
    : `<button class="pencil" data-act="edit" data-id="${esc(t.id)}" aria-label="Editar">${PENCIL}</button>`;
  const origen = t.virtual
    ? (tarjetaNombre(t.tarjeta) ? `<br><span class="tiny muted">${esc(tarjetaNombre(t.tarjeta))}</span>` : "")
    : (t.cuenta&&cuentaNombre(t.cuenta)?`<br><span class="tiny muted">${esc(cuentaNombre(t.cuenta))}${
        t.cuentaDestino&&cuentaNombre(t.cuentaDestino)?` → ${esc(cuentaNombre(t.cuentaDestino))}`:""}</span>`
      : (necesitaCuenta(t)&&cuentasActivas().length
        ? `<br><span class="tiny" style="color:${COL.acc};font-weight:600">sin cuenta · asignar</span>`:""));
  return `<div class="fila"><div class="mvrow">
    ${t.virtual?tarjetaIcon(15):tipoIcon(t.tipo,15)}
    ${sinFecha?"":`<span class="d">${esc(formatFecha(t.fecha))}</span>`}
    <span class="t">${sinCat&&t.descripcion?esc(t.descripcion):esc(t.categoria)+(t.descripcion?" · "+esc(t.descripcion):"")}${
      t.esCompartido&&sumReembolsos(t)>0?` <span class="tiny muted">(neto)</span>`:""}${origen}</span>
    <span class="num">${esc(fmtV(netoDe(t),t.moneda))}</span>
    ${lapiz}
  </div>${editing?editorHTML():""}</div>`;
}

function renderActividad(){
  /* De más reciente a más antiguo por día; dentro de un mismo día, lo último cargado arriba,
     así lo que acabás de anotar aparece pegado a la cabecera y no al final de la tanda. */
  const todos=movs().filter((t)=>monthKeyOf(t.fecha)===S.monthKey)
    .sort((a,b)=>a.fecha<b.fecha?1:(a.fecha>b.fecha?-1:((Number(b.ts)||0)-(Number(a.ts)||0))));
  const faltan=todos.filter(necesitaCuenta);
  if(!faltan.length) S.soloSinCuenta=false;
  const list = S.soloSinCuenta ? faltan : todos;
  const st=computeMonthStats(movs(),S.monthKey).ARS;
  const p=[`<div class="pad stack" style="gap:15px">`];
  p.push(`<h2 class="h" style="font-size:16px;margin:0">Todos los movimientos</h2>`);
  p.push(`<div class="monthnav">
    <button data-act="mes" data-d="-1" aria-label="Mes anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 6l-6 6 6 6"/></svg></button>
    <span class="h">${esc(monthLabel(S.monthKey))}</span>
    <button data-act="mes" data-d="1" aria-label="Mes siguiente">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 6l6 6-6 6"/></svg></button>
  </div>`);
  if(faltan.length && cuentasActivas().length) p.push(`<button class="card"
      style="border-color:${COL.acc};background:${S.soloSinCuenta?"var(--accent-bg)":"var(--card)"};
      display:flex;align-items:center;gap:11px;text-align:left;width:100%" data-act="filtro-sc">
    <span class="ico" style="background:var(--card-2);flex:none">${dwIcon("banco")}</span>
    <span style="flex:1;font-size:13px;line-height:1.4">
      ${faltan.length>1?`${faltan.length} movimientos`:`1 movimiento`} sin cuenta asignada
      <span class="tiny muted" style="display:block">${S.soloSinCuenta
        ? "tocá para volver a ver todos"
        : "tocá para verlos y asignarles cuenta con el lápiz"}</span></span>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="${COL.acc}" stroke-width="2.4"
      stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
  </button>`);

  {
    p.push(S.soloSinCuenta
      ? `<div class="tiny muted">${list.length} movimiento${list.length===1?"":"s"} sin asignar ·
          tocá el lápiz para elegirle la cuenta</div>`
      : `<div class="tiny muted">${list.length} movimiento${list.length===1?"":"s"} ·
          ingresos <span class="num" style="color:${COL.in}">${esc(shortV(st.totalIngreso))}</span> ·
          gastos <span class="num" style="color:${COL.out}">${esc(shortV(st.totalGasto))}</span></div>`);
    if(list.length) p.push(`<div>${porDia(list)}</div>`);
  }
  p.push(`</div>`);
  $view.innerHTML=p.join("");
}

