        cuentasActivas().map((c)=>`<option value="${esc(c.id)}"${c.id===st.cuentaDefault?" selected":""}>${esc(c.nombre)}</option>`).join("")}</select>
      <div class="tiny muted">La que se usa cuando cargás un movimiento sin aclarar de dónde salió la plata.</div></div>
    <div class="field"><label for="cf-preg">Cuando cargás por chat</label>
      <select id="cf-preg" data-cf="preguntarCuenta">
        <option value="faltante"${(st.preguntarCuenta||"faltante")==="faltante"?" selected":""}>Preguntarme la cuenta solo si no la menciono</option>
        <option value="siempre"${st.preguntarCuenta==="siempre"?" selected":""}>Preguntarme siempre, para confirmar</option>
        <option value="nunca"${st.preguntarCuenta==="nunca"?" selected":""}>No preguntarme: usar la de por defecto</option>
      </select></div>`:""}
  </div>`);

  p.push(`<div class="stack" style="gap:10px" id="objetivos">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:8px">
      <h2 class="h" style="font-size:16px;margin:0">Objetivos de gasto</h2>
      <span class="tiny" style="text-align:right;color:${pctTotal>100?COL.out:"var(--ink-soft)"}">
        <span class="num">${esc(fmtV(comprometido))}</span><br>${pctTotal}% del ingreso estimado</span>
    </div>
    <div class="tiny muted" style="margin-top:-4px">Tocá el <strong>%</strong> o el <strong>$</strong> de cada fila
      para cambiar entre un porcentaje del ingreso y un monto fijo.</div>
    ${st.categoriasGasto.map((c)=>{const o=objetivoDe(c,st);const esMonto=o.tipo==="monto";return `<div class="objrow">
      <span class="nm">${esc(c)}</span>
      ${esMonto
        ? `<input data-obj="${esc(c)}" type="text" inputmode="decimal" autocomplete="off" class="obj-monto"
             aria-label="Objetivo ${esc(c)} en pesos" value="${esc(montoTxt(o.valor))}">`
        : `<input data-obj="${esc(c)}" type="number" inputmode="decimal" step="0.1"
             aria-label="Objetivo ${esc(c)} en porcentaje" value="${esc(o.valor)}">`}
      <button class="obj-modo" data-act="obj-modo" data-id="${esc(c)}"
