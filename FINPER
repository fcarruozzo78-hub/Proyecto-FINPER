function compraFormHTML(){
  const f=S.compraForm; if(!f) return "";
  const cats=S.settings.categoriasGasto;
  const tjs=tarjetasActivas();
  const tj=tarjetaById(f.tarjeta);
  const m=numAR(f.monto);
  const total=Math.abs(isNaN(m)?0:m);
  const N=Math.max(1,Math.min(48,Number(f.cuotas)||1));
  const prev = (total && tj)
    ? (()=>{
        const cs=cuotasDeCompra({...f,id:"prev",monto:total,cuotas:N,categoria:f.categoria});
        if(!cs.length) return "";
        const primera=cs[0], ultima=cs[cs.length-1];
        return N>1
          ? `${N} cuotas de ${formatMoney(montoCuota({monto:total,cuotas:N},1),f.moneda)}, `
            + `de ${monthLabel(monthKeyOf(primera.fecha))} a ${monthLabel(monthKeyOf(ultima.fecha))}. `
            + `Cada una cuenta como gasto de su mes.`
          : `Un pago de ${formatMoney(total,f.moneda)}: entra en el resumen que vence el `
            + `${formatFecha(primera.fecha)}, así que cuenta como gasto de ${monthLabel(monthKeyOf(primera.fecha))}.`;
      })()
    : "";
  return `<div class="card stack" style="gap:11px">
    <div class="h" style="font-size:13.5px">${f.id?"Editar compra":"Nueva compra con tarjeta"}</div>
    <div class="field"><label for="cp-tj">Tarjeta</label>
      <select id="cp-tj" data-cp="tarjeta">${tjs.map((t)=>`<option value="${esc(t.id)}"${t.id===f.tarjeta?" selected":""}>${esc(t.nombre)}</option>`).join("")}</select></div>
    <div class="field"><label for="cp-desc">Qué compraste</label>
      <input id="cp-desc" data-cp="descripcion" type="text" placeholder="ej: Campera" value="${esc(f.descripcion)}"></div>
    <div class="grid2">
      <div class="field"><label for="cp-monto">Monto total</label>
        <input id="cp-monto" data-cp="monto" type="text" inputmode="decimal" autocomplete="off" value="${esc(montoTxt(f.monto))}"></div>
      <div class="field"><label for="cp-cuotas">Cuotas</label>
        <input id="cp-cuotas" data-cp="cuotas" type="number" inputmode="numeric" min="1" max="48" value="${esc(f.cuotas)}"></div>
      <div class="field"><label for="cp-moneda">Moneda</label>
        <select id="cp-moneda" data-cp="moneda">${["ARS","USD"].map((x)=>`<option value="${x}"${x===f.moneda?" selected":""}>${x}</option>`).join("")}</select></div>
      <div class="field"><label for="cp-cat">Categoría</label>
        <select id="cp-cat" data-cp="categoria">${cats.map((c)=>`<option value="${esc(c)}"${c===f.categoria?" selected":""}>${esc(c)}</option>`).join("")}</select></div>
    </div>
    <div class="field"><label for="cp-fecha">Fecha de la compra</label>
      <input id="cp-fecha" data-cp="fecha" type="date" value="${esc(f.fecha)}" style="min-width:0;max-width:100%"></div>
    ${prev?`<div class="tiny" style="color:${COL.acc};line-height:1.5">${esc(prev)}</div>`:""}
    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
      ${f.id?`<button class="chip danger" data-act="cp-del" data-id="${esc(f.id)}">Eliminar</button>`:`<span></span>`}
      <span style="display:flex;gap:8px">
        <button class="chip" data-act="cp-cancel">Cancelar</button>
        <button class="solid" data-act="cp-save">Guardar</button>
      </span>
    </div>
  </div>`;
}

function resumenBloque(tj,ciclo){
  const cuotas=cuotasDeCiclo(tj.id,ciclo);
  const total=totalCiclo(tj.id,ciclo);
  const cierre=fechaCierre(tj,ciclo), vence=fechaVencimiento(tj,ciclo);
  const hoy=todayISO();
  const cerrado=cierre<=hoy;
  const vencido=vence<hoy;
  const pagado=cicloPagado(tj,ciclo);
  const abierto=S.pagoId===(tj.id+"|"+ciclo);
  const liq=cuentasActivas().filter((c)=>c.tipo!=="inversion");
  const ctaSel=S.pagoCuenta||tj.cuentaPago||cuentaDefaultValida(S.settings)||"";
  return `<div class="card stack" style="gap:10px;${!pagado&&vencido?`border-color:${COL.out}`:!pagado&&cerrado?`border-color:${COL.acc}`:""}">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:10px">
      <div style="min-width:0">
        <div class="tiny muted">Resumen de ${esc(monthLabel(ciclo))}</div>
        <div class="num" style="font-size:21px;font-weight:700;line-height:1.2">${esc(fmtV(total,tj.moneda))}</div>
      </div>
      <div class="tiny" style="flex:none;text-align:right;line-height:1.5;color:${
        pagado?COL.in:vencido?COL.out:cerrado?COL.acc:"var(--ink-soft)"}">
        ${pagado?"✓ pagado":cerrado?(vencido?`venció el ${esc(formatFecha(vence))}`:`vence el ${esc(formatFecha(vence))}`)
          :`cierra el ${esc(formatFecha(cierre))}`}
      </div>
    </div>
    ${cuotas.length?`<div>${cuotas.map((c)=>`<div class="mvrow" style="padding:7px 0">
      <span class="dot" style="background:${categoryColor(c.categoria,S.settings)}"></span>
      <span class="t">${esc(c.descripcion)} <span class="muted tiny">· ${esc(c.categoria)}</span></span>
      <span class="num">${esc(fmtV(c.monto,c.moneda))}</span>
      <button class="pencil" data-act="cp-edit" data-id="${esc(c.compraId)}" aria-label="Editar la compra">${PENCIL}</button>
    </div>`).join("")}</div>`:`<div class="tiny muted">Sin consumos en este resumen.</div>`}
    ${pagado
      ? `<button class="tiny" data-act="tj-unpay" data-tj="${esc(tj.id)}" data-c="${esc(ciclo)}"
           style="color:${COL.soft};text-align:left">deshacer el pago</button>`
      : !cerrado
      ? `<div class="tiny muted">Todavía se está armando: lo que compres hasta el ${esc(formatFecha(cierre))}
           entra en este resumen. Vas a poder pagarlo cuando cierre.</div>`
      : total>0
        ? (abierto
          ? `<div class="stack" style="gap:9px">
              <div class="field"><label for="pg-cta">Pagar desde</label>
                <select id="pg-cta" data-pg="cuenta"><option value="">Sin cuenta</option>${
                  liq.map((c)=>`<option value="${esc(c.id)}"${c.id===ctaSel?" selected":""}>${esc(c.nombre)}</option>`).join("")}</select></div>
              <div class="tiny muted">Se registra como transferencia: te baja el saldo de esa cuenta y cancela
                la deuda, pero no vuelve a contar como gasto del mes.</div>
              <div style="display:flex;gap:8px;justify-content:flex-end">
                <button class="chip" data-act="tj-pay-cancel">Cancelar</button>
                <button class="solid" data-act="tj-pay-ok" data-tj="${esc(tj.id)}" data-c="${esc(ciclo)}">Confirmar pago</button>
              </div>
            </div>`
          : `<button class="solid" style="width:100%" data-act="tj-pay" data-tj="${esc(tj.id)}" data-c="${esc(ciclo)}">
              Pagar el resumen</button>`)
        : ""}
  </div>`;
}

function renderTarjetas(){
  const tjs=tarjetasActivas();
  const p=patrimonio();
  const out=[`<div class="pad stack" style="gap:16px">`];

  out.push(`<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px">
    <div><h2 class="h" style="font-size:16px;margin:0">Tarjetas</h2>
      <div class="tiny muted" style="margin-top:3px">${p.deudaTotal
        ? `Debés <span class="num" style="color:${COL.out}">${esc(fmtV(p.deudaTotal))}</span> en total`
        : tjs.length ? "Sin deuda pendiente" : "Todavía no cargaste ninguna"}</div></div>
    ${(!S.tarjetaForm&&!S.compraForm)?`<button class="chip" data-act="tj-new" style="flex:none">+ Tarjeta</button>`:""}
  </div>`);

  if(S.tarjetaForm) out.push(tarjetaFormHTML());
  if(S.compraForm) out.push(compraFormHTML());

  if(!tjs.length && !S.tarjetaForm){
    out.push(`<div class="empty">Cargá una tarjeta con su día de cierre y su día de vencimiento.<br><br>
      Después, cuando cargues una compra en cuotas, la app reparte las cuotas en los meses que corresponden:
      cada una cuenta como gasto del mes en que vence, no el día que compraste.<br><br>
      <strong>Solo el nombre.</strong> La app nunca te va a pedir el número de la tarjeta ni ningún otro dato.</div>`);
    out.push(`</div>`);
    $view.innerHTML=out.join("");
    return;
  }

  if(tjs.length && !S.compraForm && !S.tarjetaForm){
    out.push(`<button class="solid" style="width:100%" data-act="cp-new">+ Cargar una compra</button>`);
  }

  tjs.forEach((tj)=>{
    const ciclos=ciclosDeTarjeta(tj.id);
    const pend=cicloPendiente(tj);
    const futuros=ciclos.filter((c)=>!cicloPagado(tj,c) && c!==pend);
    const deuda=ciclos.filter((c)=>!cicloPagado(tj,c)).reduce((a,c)=>a+totalCiclo(tj.id,c),0);
    const compras=S.compras.filter((cp)=>cp.tarjeta===tj.id)
      .sort((a,b)=>a.fecha<b.fecha?1:(a.fecha>b.fecha?-1:0));

    out.push(`<div class="stack" style="gap:11px">
      <div style="display:flex;align-items:center;gap:9px">
        <span class="ico" style="background:var(--card);flex:none">${tarjetaIcon(15,COL.acc)}</span>
        <span style="flex:1;min-width:0">
          <span class="h" style="font-size:14.5px">${esc(tj.nombre)}</span>
          <span class="tiny muted" style="display:block">cierra el ${esc(String(tj.cierre))} · vence el ${esc(String(tj.vencimiento))}${
            tj.moneda==="USD"?" · USD":""}${deuda?` · debés <span class="num">${esc(fmtV(deuda,tj.moneda))}</span>`:""}</span>
        </span>
        <button class="pencil" data-act="tj-edit" data-id="${esc(tj.id)}" aria-label="Editar tarjeta">${PENCIL}</button>
      </div>`);

    if(pend) out.push(resumenBloque(tj,pend));
    else if(!ciclos.length) out.push(`<div class="tiny muted">Todavía no cargaste compras con esta tarjeta.</div>`);
    else {
      out.push(`<div class="tiny muted">No tenés resúmenes pendientes. El último fue este:</div>`);
      out.push(resumenBloque(tj,ciclos[ciclos.length-1]));
    }

    if(futuros.length){
      out.push(`<div><h3 class="sechead">Lo que viene</h3>${futuros.map((c)=>`<div class="mvrow">
        <span class="dot" style="background:${COL.soft}"></span>
        <span class="t muted">${esc(monthLabel(c))} <span class="tiny">· vence el ${esc(formatFecha(fechaVencimiento(tj,c)))}</span></span>
        <span class="num">${esc(fmtV(totalCiclo(tj.id,c),tj.moneda))}</span>
      </div>`).join("")}</div>`);
    }

    if(compras.length){
      out.push(`<div><h3 class="sechead">Compras cargadas</h3>${compras.map((cp)=>{
        const N=Math.max(1,Number(cp.cuotas)||1);
        const restantes=cuotasDeCompra(cp).filter((c)=>!cicloPagado(tj,c.ciclo)).length;
        return `<div class="mvrow">
          <span class="dot" style="background:${categoryColor(cp.categoria,S.settings)}"></span>
          <span class="t">${esc(cp.descripcion)}
            <span class="muted tiny">· ${esc(formatFecha(cp.fecha))}${N>1?` · ${N} cuotas`:" · un pago"}${
              restantes?` · quedan ${restantes}`:" · saldada"}</span></span>
          <span class="num">${esc(fmtV(cp.monto,cp.moneda))}</span>
          <button class="pencil" data-act="cp-edit" data-id="${esc(cp.id)}" aria-label="Editar compra">${PENCIL}</button>
        </div>`;}).join("")}</div>`);
    }
    out.push(`</div>`);
  });

  out.push(`</div>`);
  $view.innerHTML=out.join("");
}

