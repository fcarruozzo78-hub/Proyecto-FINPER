/* migraciones sobre datos ya guardados */
function migrateSettings(sett){
  let s=sett, migrated=false;
  if(s.categoriasGasto && s.categoriasGasto.includes("Comida")){
    const idx=s.categoriasGasto.indexOf("Comida");
    const cats=[...s.categoriasGasto]; cats.splice(idx,1,"Supermercado","Almacén/Kiosco");
    const old=s.objetivos&&s.objetivos["Comida"]!=null?s.objetivos["Comida"]:15;
    const sup=Math.round(old*0.73);
    const obj={...s.objetivos}; delete obj["Comida"]; obj["Supermercado"]=sup; obj["Almacén/Kiosco"]=old-sup;
    s={...s,categoriasGasto:cats,objetivos:obj}; migrated=true;
  }
  if(!s.categoriasIngreso || !s.categoriasIngreso.includes("Diferencia por devolución")){
    s={...s,categoriasIngreso:[...(s.categoriasIngreso||CATEGORIAS_INGRESO),"Diferencia por devolución"]};
    migrated=true;
  }
  /* Tres categorías que faltaban para que "Otros" deje de ser un cajón: dos nuevas y
     Servicios, para los gastos del departamento. Se agregan UNA sola vez y queda la marca:
     si después las borrás, no vuelven solas. No se les pone objetivo: ese lo elegís vos. */
  if(!(Number(s.migCats)>=2)){
    const cats=[...(s.categoriasGasto||CATEGORIAS_GASTO)];
    const faltan=["Servicios","Suscripciones","Préstamos y cuotas"].filter((c)=>!cats.includes(c));
    if(faltan.length){
      const i=cats.indexOf("Otros");
      if(i>=0) cats.splice(i,0,...faltan); else cats.push(...faltan);
    }
    s={...s,categoriasGasto:cats,migCats:2};
    migrated=true;
  }
  return {settings:s,migrated};
}
/* Recategorización puntual de lo que ya estaba cargado. Los patrones son deliberadamente
   angostos y solo pisan movimientos que hoy están en el cajón de sastre: mover algo que el
   usuario categorizó a propósito sería peor que dejarlo mal. */
const RECAT=[
  [/cuota\s+pr[ée]stamo/i, "Préstamos y cuotas"],
  [/^suscripci[óo]n\b/i,   "Suscripciones"],
  [/^pago de luz$|^abl$/i,  "Servicios"],
];
const CAJON=["Otros","Entretenimiento y ocio"];
function migrateTransactions(tx){
  let migrated=false;
  const out=tx.map((t)=>{
    if(t.categoria==="Comida"){migrated=true; return {...t,categoria:"Supermercado"};}
    if(t.tipo==="gasto" && CAJON.includes(t.categoria)){
      const r=RECAT.find(([re])=>re.test(t.descripcion||""));
      if(r && r[1]!==t.categoria){ migrated=true; return {...t,categoria:r[1]}; }
    }
    return t;
  });
  return {transactions:out,migrated};
}

