/* ---------- animación de entrada ---------- */

const EASE_OUT=(t)=>1-Math.pow(1-t,3);

/* Los dígitos chicos no aportan nada mientras el número se mueve: si el recorrido es
   de 15.000, mostrar "449.732" es ruido. Redondeamos a un paso que deje unos 40 saltos
   legibles, así lo que se lee es la magnitud cambiando y no las unidades temblando. */
function pasoLegible(recorrido){
  const d=Math.abs(recorrido);
  if(!d) return 1;
  return Math.pow(10,Math.max(0,Math.floor(Math.log10(d/40))));
}
const EASE_SUAVE=(t)=>(t<0.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2);

/* `desde` en null cuenta desde cero (una llegada). Con un valor, va de ese número al
   nuevo: sirve para que el saldo baje exactamente lo que acabás de gastar. */
function contar(el,fin,moneda,corto,desde,dur,suave){
  const final=el.textContent, ini=(desde==null?0:desde), t0=performance.now();
  dur=dur||950;
  const curva = suave ? EASE_SUAVE : EASE_OUT;
  const paso = pasoLegible(fin-ini);
  const escribir=(v)=>{
    const r=Math.round(v/paso)*paso;
    el.textContent = corto ? shortV(r,moneda) : fmtV(r,moneda);
  };
  escribir(ini);
  (function frame(t){
    const p=Math.min(1,(t-t0)/dur);
    if(p>=1){ el.textContent=final; return; }
    escribir(ini+(fin-ini)*curva(p));
    requestAnimationFrame(frame);
  })(t0);
}

/* Se llama una sola vez por entrada a una pantalla. El HTML ya trae el estado final,
   así que si algo de esto falla la pantalla se ve igual, solo sin movimiento. */
function animarEntrada(root){
  if(!animOk()) return;
  const R=root||document;

  /* Con la API de animaciones en lugar de transiciones CSS: no depende de cuándo el
     navegador recalcula estilos, y al terminar cada elemento vuelve solo a su estado
     final, que ya está en el HTML. */
  const anim=(el,cuadros,opts)=>{
    if(!el.animate) return;
    try{ el.animate(cuadros,opts); }catch(e){}
  };

  /* Un fundido corto sobre toda la pantalla: hace que el cambio de pestaña se sienta
     suave incluso donde no hay números ni gráficos que animar. */
  if(R.nodeType===1) anim(R,[{opacity:0},{opacity:1}],{duration:220,easing:"ease"});

  R.querySelectorAll(".fila").forEach((el,i)=>{
    anim(el,[{opacity:0,transform:"translateY(6px)"},{opacity:1,transform:"none"}],
      {duration:340,easing:"cubic-bezier(.2,.7,.2,1)",delay:Math.min(i,10)*35,fill:"backwards"});
  });

  R.querySelectorAll(".cnt").forEach((el)=>{
    contar(el,Number(el.dataset.v)||0,el.dataset.m||"ARS",el.dataset.f==="short");
  });

  R.querySelectorAll(".drawline").forEach((el)=>{
    let L=0;
    try{ L=el.getTotalLength(); }catch(e){ return; }
    if(!L) return;
    anim(el,[{strokeDasharray:`${L} ${L}`,strokeDashoffset:L},{strokeDasharray:`${L} ${L}`,strokeDashoffset:0}],
      {duration:1060,easing:"cubic-bezier(.3,.7,.2,1)",fill:"backwards"});
  });

  R.querySelectorAll(".seg-arco").forEach((el)=>{
    const largo=Number(el.dataset.largo)||0, C=Number(el.dataset.c)||1, t0=Number(el.dataset.t0)||0;
    anim(el,[{strokeDasharray:`0 ${C}`},{strokeDasharray:`${largo} ${C-largo}`}],
      {duration:690,easing:"ease-out",delay:Math.round(t0*630),fill:"backwards"});
  });

  R.querySelectorAll(".bar > i").forEach((el,i)=>{
    anim(el,[{width:"0%"},{width:el.style.width||"0%"}],
      {duration:690,easing:"cubic-bezier(.2,.7,.2,1)",delay:Math.min(i,8)*63,fill:"backwards"});
  });

  R.querySelectorAll(".fadein").forEach((el)=>{
    anim(el,[{opacity:0},{opacity:1}],{duration:690,easing:"ease",delay:560,fill:"backwards"});
  });

  R.querySelectorAll(".fadein-tarde").forEach((el,i)=>{
    anim(el,[{opacity:0},{opacity:1}],{duration:500,easing:"ease",delay:500+i*110,fill:"backwards"});
  });
}

/* Abrir y cerrar el desplegable de una categoría. La altura no se puede animar hacia "auto",
   así que se mide el contenido y se anima hasta ese número; al terminar el elemento vuelve solo
   a su altura natural, que es lo que ya está en el HTML. */
function flecha(el){ return el && el.querySelector("svg"); }

function animarDespliegue(panel){
  if(!animOk() || !panel || !panel.animate) return;
  const anim=(el,cuadros,opts)=>{ if(el&&el.animate){ try{ el.animate(cuadros,opts); }catch(e){} } };
  const alto=panel.scrollHeight;
  anim(panel,[{height:"0px",opacity:0},{height:alto+"px",opacity:1}],
    {duration:260,easing:"cubic-bezier(.2,.7,.2,1)"});
  anim(flecha(panel.parentElement&&panel.parentElement.querySelector('[data-act="cat"]')),
    [{transform:"rotate(0deg)"},{transform:"rotate(90deg)"}],
    {duration:260,easing:"cubic-bezier(.2,.7,.2,1)"});
  /* las filas entran escalonadas, igual que en el resto de la app */
  panel.querySelectorAll(".fila").forEach((f,i)=>{
    anim(f,[{opacity:0,transform:"translateY(5px)"},{opacity:1,transform:"none"}],
      {duration:240,easing:"cubic-bezier(.2,.7,.2,1)",delay:70+Math.min(i,8)*40,fill:"backwards"});
  });
}

/* Al cerrar hay que animar ANTES de redibujar, porque el redibujado borra el elemento.
   El seguro de tiempo está para que la pantalla no quede trabada si la animación no termina
   (una pestaña en segundo plano, por ejemplo). */
function animarPliegue(panel,luego){
  if(!animOk() || !panel || !panel.animate){ luego(); return; }
  let hecho=false;
  const unaVez=()=>{ if(hecho) return; hecho=true; luego(); };
  const btn=panel.parentElement&&panel.parentElement.querySelector('[data-act="cat"]');
  if(flecha(btn)&&flecha(btn).animate){
    try{ flecha(btn).animate([{transform:"rotate(90deg)"},{transform:"rotate(0deg)"}],
      {duration:190,easing:"cubic-bezier(.4,0,.6,1)"}); }catch(e){}
  }
  let a;
  try{
    a=panel.animate([{height:panel.scrollHeight+"px",opacity:1},{height:"0px",opacity:0}],
      {duration:190,easing:"cubic-bezier(.4,0,.6,1)"});
  }catch(e){ luego(); return; }
  a.onfinish=unaVez; a.oncancel=unaVez;
  setTimeout(unaVez,400);
}

/* Elegir una porción no rehace la pantalla: se reescribe solo el centro del anillo. Un
   render completo por cada toque (o peor, por cada movimiento del mouse) perdería el scroll
   y volvería a disparar las animaciones. */
let arcoSel=null;
function pintarArco(nombre){
  const hoyo=document.getElementById("hoyo");
  if(!hoyo) return;
  const svg=hoyo.parentElement.querySelector("svg");
  if(!nombre){
    arcoSel=null; svg.classList.remove("hay-sel");
    svg.querySelectorAll(".seg-arco").forEach((c)=>c.classList.remove("sel"));
    hoyo.innerHTML=holeHTML(null,Number(hoyo.dataset.tot)||0);
    return;
  }
  /* El arco visible y su aro de toque comparten el nombre, así que se marca por nombre y no
     por el elemento que recibió el evento. */
  let datos=null;
  svg.querySelectorAll("[data-arco]").forEach((c)=>{
    const suyo=c.dataset.arco===nombre;
    if(c.classList.contains("seg-arco")) c.classList.toggle("sel",suyo);
    if(suyo) datos=c.dataset;
  });
  if(!datos) return;
  arcoSel=nombre;
  svg.classList.add("hay-sel");
  hoyo.innerHTML=holeHTML({nombre,monto:Number(datos.monto)||0,pct:datos.pct,col:datos.col},0);
}

