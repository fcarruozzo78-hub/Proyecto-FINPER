/* menú lateral */
function navTo(act){
  if(act.startsWith("vista:")){
    S.settings={...S.settings,monedaVista:act.slice(6)==="USD"?"USD":"ARS"};
    persistSettings(); render();
    return;
  }
  if(act==="csv"){ closeDrawer(true); exportCSV(); return; }
  if(act==="objetivos"){ if(S.tab!=="config"){ S.entrada=true; S.saldoAnim=false; } S.tab="config"; S.scrollTo="objetivos"; }
  else { if(S.tab!==act){ S.entrada=true; S.saldoAnim = act==="resumen"; } S.tab=act; }
  closeEditor(); closeDrawer(); render();
}
