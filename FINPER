function uid(){ return (crypto && crypto.randomUUID) ? crypto.randomUUID() : Math.random().toString(36).slice(2)+Date.now(); }
function todayISO(){ const d=new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`; }
/* Anotar algo que pasó hace unos días es normal —uno se olvida de cargarlo—, pero mover un
   movimiento a un mes ya cerrado es otra cosa: el resumen, los objetivos y la proyección de
   ese mes son números que uno ya dio por buenos. El límite es el mes en curso, y nunca una
   fecha que todavía no llegó. Fuera de eso la fecha vuelve a ser hoy, y se avisa: guardar mal
   en silencio es peor que no aceptar la fecha. */
function fechaEnRango(f,mk){
  if(!/^\d{4}-\d{2}-\d{2}$/.test(String(f||""))) return false;
  const hoy=todayISO(), ref=mk||monthKeyOf(hoy);
  if(monthKeyOf(f)!==ref) return false;
  return !(ref===monthKeyOf(hoy) && f>hoy);
}
function fechaValida(f){ return fechaEnRango(f) ? f : todayISO(); }
function ultimoDiaDe(mk){
  const [y,m]=mk.split("-").map(Number);
  return `${mk}-${String(new Date(y,m,0).getDate()).padStart(2,"0")}`;
}
/* Hasta dónde puede moverse la fecha de un movimiento que ya existe: dentro de su propio mes,
   y sin pasarse de hoy si ese mes es el que está corriendo. */
function topeFecha(mk){
  const hoy=todayISO();
  return mk===monthKeyOf(hoy) ? hoy : ultimoDiaDe(mk);
}

function monthKeyOf(iso){ return (iso||todayISO()).slice(0,7); }
function monthLabel(mk){ const [y,m]=mk.split("-").map(Number); const d=new Date(y,m-1,1);
  const s=d.toLocaleDateString("es-AR",{month:"long",year:"numeric"}); return s.charAt(0).toUpperCase()+s.slice(1); }
function monthShort(mk){ const [y,m]=mk.split("-").map(Number); const d=new Date(y,m-1,1);
  return d.toLocaleDateString("es-AR",{month:"short"}).replace(".","").slice(0,3); }
function shiftMonth(mk,delta){ const [y,m]=mk.split("-").map(Number); const d=new Date(y,m-1+delta,1);
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}`; }
function formatFecha(iso){ if(!iso) return ""; const p=iso.split("-"); return `${p[2]}/${p[1]}`; }

function formatMoney(amount,moneda){
  const n=Number(amount)||0;
  const hasCents=Math.round(Math.abs(n)*100)%100!==0;
  const digits=hasCents?2:0;
  try{
    return new Intl.NumberFormat("es-AR",{style:"currency",currency:moneda==="USD"?"USD":"ARS",
      minimumFractionDigits:digits,maximumFractionDigits:digits}).format(n);
  }catch(e){
    return `${moneda==="USD"?"US$":"$"} ${n.toLocaleString("es-AR",{minimumFractionDigits:digits,maximumFractionDigits:digits})}`;
  }
}
function short$(n){
  const a=Math.abs(n);
  if(a>=1e6) return "$"+(n/1e6).toFixed(a>=1e7?0:1).replace(".",",")+"M";
  if(a>=1e3) return "$"+Math.round(n/1e3)+"k";
  return "$"+Math.round(n);
}
function normalize(s){ return (s||"").toString().toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g,""); }

/* Los campos de monto son type="text": el type="number" del navegador solo acepta el
   punto como decimal, así que en formato argentino ("119.010,87") descarta los
   separadores y deja 11901087. Acá lo interpretamos nosotros. */
function numAR(txt){
  if(txt==null) return NaN;
  let s=String(txt).trim().replace(/\s| |\$|US\$|ARS|USD/gi,"");
  if(!s) return NaN;
  const neg=/^-/.test(s);
  s=s.replace(/^[-+]/,"");
  if(!/^[\d.,]+$/.test(s)) return NaN;
  const punto=s.includes("."), coma=s.includes(",");
  if(punto && coma){
    s=s.replace(/\./g,"").replace(/,/g,".");        // 119.010,87
  } else if(coma){
    s=s.replace(/,/g,".");                           // 119010,87
  } else if(punto){
    const partes=s.split(".");
    const ultima=partes[partes.length-1];
    /* "119.010" son miles; "119.01" es decimal. Tres dígitos al final = separador. */
    if(partes.length>2 || (ultima.length===3 && partes[0].length>0)) s=partes.join("");
  }
  const n=Number(s);
  return isNaN(n) ? NaN : (neg?-n:n);
}
/* Para mostrar un monto dentro de un campo editable, sin símbolo de moneda. */
function montoTxt(n){
  const v=Number(n);
  if(!isFinite(v)||v===0) return "";
  return v.toLocaleString("es-AR",{maximumFractionDigits:2});
}
function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,(c)=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

function isUndoCommand(text){
