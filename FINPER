      && /(movimiento|carga|registro|reembolso|gasto|ingreso|eso)/.test(n);
}
function sumReembolsos(t){ return (t.reembolsos||[]).reduce((s,r)=>s+(Number(r.monto)||0),0); }
function netoDe(t){ return t.tipo==="gasto" ? Math.max(0,(Number(t.monto)||0)-sumReembolsos(t)) : (Number(t.monto)||0); }

function validateCategoria(tipo,cat,settings){
  const norm=normalize(cat);
  if(tipo==="gasto"){
    const list=(settings&&settings.categoriasGasto)||CATEGORIAS_GASTO;
    return list.find((c)=>normalize(c)===norm||norm.includes(normalize(c))||normalize(c).includes(norm))||"Otros";
  }
  if(tipo==="ingreso"){
    const list=(settings&&settings.categoriasIngreso)||CATEGORIAS_INGRESO;
    return list.find((c)=>normalize(c)===norm||norm.includes(normalize(c))||normalize(c).includes(norm))||"Otros ingresos";
  }
  if(tipo==="ahorro") return "Ahorro";
  if(tipo==="inversion") return "Inversión";
  if(tipo==="transferencia") return "Transferencia";
  if(tipo==="ajuste") return "Ajuste de saldo";
  return cat||"Otros";
}
