function renderChat(){
  const parts=[];
  parts.push('<div id="chatlist">');
  for(const m of S.messages){
    if(m.role==="user"){ parts.push(`<div class="bub me">${esc(m.text)}</div>`); continue; }

    if(m.kind==="confirm"){
      const tx=txById(m.txId);
      const editing = S.editingId===m.id && S.editForm;
      const picker = (tx && !editing) ? cuentaPickerHTML(m,tx) : "";
      const aviso = (tx && !editing && !picker && m.omitido && necesitaCuenta(tx))
        ? `<div class="tiny muted" style="margin-top:7px">Quedó sin cuenta asignada. Lo vas a encontrar
             marcado en <button data-nav="actividad" style="color:${COL.acc};font-weight:600">Actividad</button>.</div>`
        : "";
      parts.push(`<div class="bub bot"><div class="row">
        ${tipoBadge(tx?tx.tipo:"gasto")}
        <span style="flex:1">${esc(m.text)}</span>
        ${tx&&!editing?`<button class="pencil" data-act="edit" data-id="${esc(tx.id)}" data-msg="${esc(m.id)}" aria-label="Editar">${PENCIL}</button>`:""}
      </div>${picker}${aviso}${editing?editorHTML():""}</div>`);
      continue;
    }
    if(m.kind==="chooser"){
      const q = m.mode==="correccion"
        ? `¿Cuál de estos movimientos de este mes querés corregir a ${esc(TIPO_LABEL[m.parsed.nuevoTipo]||m.parsed.nuevoTipo||"otro tipo")}?`
        : `¿A cuál de estos gastos compartidos corresponde este reembolso de ${esc(formatMoney(m.parsed.monto,m.parsed.moneda))}?`;
      const btns=m.candidates.map((c)=>{
        const tx=txById(c.txId); if(!tx) return "";
        return `<button class="chip" style="width:100%" data-act="choose" data-msg="${esc(m.id)}" data-id="${esc(tx.id)}">${optHTML(tx,m.mode)}</button>`;
      }).join("");
      parts.push(`<div class="bub bot"><div style="margin-bottom:8px">${q}</div>
        <div class="stack" style="gap:6px">${btns}
        <button class="chip muted" style="width:100%" data-act="choose" data-msg="${esc(m.id)}">Ninguno de estos</button></div></div>`);
      continue;
    }
    if(m.kind==="multi"){
      const total=Math.abs(Number(m.parsed.monto)||0);
      const suma=sumaReparto(m);
      const dif=Math.round((total-suma)*100)/100;
      const filas=m.filas.map((f,i)=>{
        const tx=f.txId?txById(f.txId):null;
        const elegir = !tx || f.abrir;
        const opciones = elegir ? `<div class="stack" style="gap:6px;margin-top:5px">
            ${f.candidates.map((id)=>{ const c=txById(id); if(!c) return "";
              return `<button class="chip${f.txId===c.id?" on":""}" style="width:100%"
                data-act="multi-pick" data-msg="${esc(m.id)}" data-i="${i}" data-id="${esc(c.id)}"
                >${optHTML(c,"reembolso")}</button>`; }).join("")}
            <button class="chip${!f.txId?" on":""}" style="width:100%" data-act="multi-pick"
              data-msg="${esc(m.id)}" data-i="${i}" data-id="omit"
              >${f.candidates.length?"Ninguno de estos":"No lo había cargado"}</button>
          </div>` : "";
        const dicho = f.spec && (f.spec.monto>0 ? "vos dijiste el monto"
                     : f.spec.fraccion>0 ? `vos dijiste ${f.spec.fraccion===0.5?"la mitad":Math.round(f.spec.fraccion*100)+"%"} de ese gasto`
                     : f.spec.resto ? "vos dijiste el resto" : "");
        /* El gasto elegido se puede cambiar aunque la app esté segura: dos compras con el
           mismo nombre se distinguen mirando el monto, y eso lo sabe el usuario, no la app. */
        const cambiar = tx && !f.abrir && f.candidates.length>1
          ? ` <button class="tiny" style="color:${COL.acc};padding:2px 4px" data-act="multi-open"
              data-msg="${esc(m.id)}" data-i="${i}">cambiar</button>` : "";
        return `<div style="margin-top:11px">
          <div class="tiny" style="margin-bottom:4px">"${esc(f.concepto)}"${
            tx?` <span class="muted">→ ${esc(tx.descripcion||tx.categoria)} ${esc(formatMoney(tx.monto,tx.moneda))}</span>`:""}${cambiar}</div>
          ${opciones}
          <div style="display:flex;align-items:center;gap:8px;margin-top:6px">
            <input type="text" inputmode="decimal" autocomplete="off" style="flex:1"
              data-rp="${i}" data-msg="${esc(m.id)}" ${tx?"":"disabled"}
              value="${esc(tx?montoTxt(f.monto):"")}" placeholder="0">
            ${tx?`<span class="tiny muted" style="flex:none">de ${esc(formatMoney(saldoAbierto(tx),tx.moneda))}</span>`:""}
          </div>
          ${dicho?`<div class="tiny muted" style="margin-top:3px">${dicho}</div>`:""}
        </div>`;
      }).join("");
      parts.push(`<div class="bub bot">
        <div style="margin-bottom:2px">Esta devolución de ${esc(formatMoney(m.parsed.monto,m.parsed.moneda))}
          toca más de un gasto. ${m.indeterminado
            ? "No me dijiste cuánto va a cada uno, así que lo repartí en proporción a lo que falta cobrar de cada uno."
            : "Este es el reparto; cambialo si no es así."}</div>
        ${filas}
        <div class="tiny" style="margin-top:11px;color:${Math.abs(dif)<0.01?COL.soft:COL.acc}"
          id="rp-tot-${esc(m.id)}">${esc(repartoPie(total,suma,m.parsed.moneda))}</div>
        <button class="solid" style="margin-top:9px" data-act="multi-ok" data-msg="${esc(m.id)}">Confirmar reparto</button>
      </div>`);
      continue;
    }
    if(m.kind==="ask"){
      parts.push(`<div class="bub bot"><div style="margin-bottom:8px">${esc(m.text)}</div>
        <button class="chip muted" data-act="cancel-reemb" data-msg="${esc(m.id)}">Cancelar</button></div>`);
      continue;
    }
    if(m.kind==="error"){
      parts.push(`<div class="bub bot"><div class="row">
        <span class="ico" style="background:var(--out-bg)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"
          stroke="${COL.out}" stroke-width="2.2" stroke-linecap="round"><path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9"/></svg></span>
        <span style="flex:1">${esc(m.text)}</span></div></div>`);
      continue;
    }
    parts.push(`<div class="bub bot">${esc(m.text)}</div>`);
  }
  if(S.isProcessing) parts.push(`<div class="bub bot muted">Interpretando…</div>`);
  parts.push("</div>");

  if(S.messages.length<=1){
    parts.push(`<div class="chips">${[
      "Gasté 5000 en el supermercado","Cobré el sueldo, 950000","Juan me devolvió 3000 de la cena"
    ].map((ex)=>`<button class="chip" data-act="example">${esc(ex)}</button>`).join("")}</div>`);
  }

  $view.innerHTML=parts.join("");
  const list=document.getElementById("chatlist");
  if(list) $view.scrollTop=$view.scrollHeight;
}

/* El centro del anillo hace de globo de información. En un teléfono un tooltip flotante hay
   que ubicarlo, tapa lo que estás mirando y se va al primer toque en otro lado; el centro ya
   está ahí, siempre en el mismo lugar y del tamaño justo. */
function holeHTML(sel,total){
  if(!sel) return `<span class="tiny muted" style="letter-spacing:.04em">Gasto</span>
    <span class="num" style="font-weight:700;font-size:25px;line-height:1.2">${nAnim(total,"ARS","short")}</span>`;
  return `<span class="tiny" style="color:${esc(sel.col)};max-width:82%;text-align:center;
      overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(sel.nombre)}</span>
    <span class="num" style="font-weight:700;font-size:23px;line-height:1.2">${esc(shortV(sel.monto))}</span>
    <span class="tiny muted">${sel.pct}% del gasto</span>`;
}

/* La torta ordena las porciones por monto, así que dos colores parecidos pueden caer
   pegados y leerse como una sola porción. Los pares parecidos están medidos arriba: si
   alguno queda de vecino, se reacomoda el orden de dibujo —la porción más grande se queda
   primera— hasta que no se toquen. No cambia ningún tamaño, solo en qué orden se dibujan. */
function idxColor(c){ return CATEGORY_COLORS.indexOf(c); }
function choques(idxs){
  let n=0;
  for(let k=0;k<idxs.length;k++) n+=costoPar(idxs[k],idxs[(k+1)%idxs.length]);
  return n;
}
function ordenarArcos(datos){
  if(datos.length<3) return datos;
  const idx=datos.map((d)=>idxColor(d[2]));
  if(!choques(idx)) return datos;            /* el orden por monto ya sirve: no se toca */
  let mejor=null, mejorCh=Infinity;
  const perm=(quedan,armado)=>{
    if(mejorCh===0) return;
    if(!quedan.length){
      const orden=[0,...armado], ch=choques(orden.map((i)=>idx[i]));
      if(ch<mejorCh){ mejorCh=ch; mejor=orden; }
      return;
    }
    for(let i=0;i<quedan.length;i++)
      perm([...quedan.slice(0,i),...quedan.slice(i+1)],[...armado,quedan[i]]);
  };
  perm(datos.map((_,i)=>i).slice(1),[]);
  return mejor ? mejor.map((i)=>datos[i]) : datos;
}

function donutHTML(pairs,total){
  const R=52, GROSOR=13, C=2*Math.PI*R;
  /* El tope de seis arcos es de legibilidad, no estético: más porciones en un anillo de este
     tamaño se vuelven tajaditas imposibles de comparar. Del sexto en adelante todo va a una
     porción neutra. Quién es cada uno se lee en las barras de abajo, que usan los mismos
     colores; el orden de las porciones puede no coincidir con el de las barras, porque se
     reacomodan para que dos colores parecidos nunca queden pegados. */
  const vacio = !pairs.length || !(total>0);
  const MAX=5;
  const datos = vacio ? [] : (pairs.length>MAX+1
    ? [...pairs.slice(0,MAX),[`Otras (${pairs.length-MAX})`,pairs.slice(MAX).reduce((a,x)=>a+x[1],0),COL.soft]]
    : pairs);
  const arcos=ordenarArcos(datos);
  let acc=0;
  const segs = vacio
    ? `<circle cx="60" cy="60" r="${R}" fill="none" stroke="var(--track)" stroke-width="${GROSOR}"/>`
    : arcos.map(([name,val,color])=>{
    const frac=val/total;
    /* El corte entre porciones se ve siempre, incluso entre dos colores parecidos: es lo que
       permite contar y comparar tamaños sin depender del tono. */
    const largo=Math.max(0, frac*C-3.2);
    const off=-(acc*C);
    acc+=frac;
    const pct=Math.round(frac*100);
    return `<circle class="seg-arco" cx="60" cy="60" r="${R}" fill="none" stroke="${color}"
      stroke-width="${GROSOR}" stroke-dasharray="${largo.toFixed(2)} ${(C-largo).toFixed(2)}"
      stroke-dashoffset="${off.toFixed(2)}" transform="rotate(-90 60 60)"
      data-largo="${largo.toFixed(2)}" data-c="${C.toFixed(2)}" data-t0="${(acc-frac).toFixed(4)}"
      data-arco="${esc(name)}" data-pct="${pct}" data-monto="${val}" data-col="${esc(color)}"
      ><title>${esc(name)} · ${pct}%</title></circle>`
    + `<circle class="aro-toque" cx="60" cy="60" r="${R}" fill="none" stroke="transparent"
      stroke-width="24" stroke-dasharray="${largo.toFixed(2)} ${(C-largo).toFixed(2)}"
      stroke-dashoffset="${off.toFixed(2)}" transform="rotate(-90 60 60)"
      data-arco="${esc(name)}" data-pct="${pct}" data-monto="${val}" data-col="${esc(color)}"/>`;
  }).join("");
  return `<div class="donutwrap">
    <div class="donut">
      <svg viewBox="0 0 120 120" role="img"
        aria-label="Distribución del gasto por categoría">${segs}</svg>
      <div class="hole" id="hoyo" data-tot="${total}">${holeHTML(null,total)}
        ${vacio?`<span class="tiny muted" style="margin-top:2px">sin gastos este mes</span>`:""}</div>
    </div></div>`;
}

/* Los movimientos que hay detrás de una barra de categoría, en el mes que se está viendo.
   Las cuotas de tarjeta entran igual que cualquier otro gasto: ya son gasto de este mes. */
function movsDeCategoria(nombre,tipo){
  return movs().filter((t)=>{
    if(monthKeyOf(t.fecha)!==S.monthKey) return false;
    if(tipo==="gasto") return t.tipo==="gasto" && t.categoria===nombre;
    return t.tipo===tipo;
  }).sort((a,b)=>a.fecha<b.fecha?1:(a.fecha>b.fecha?-1:0));
}

function renderResumen(){
  const st=computeMonthStats(movs(),S.monthKey);
  const s=st.ARS, sUSD=st.USD;
  const estim=(Number(S.settings.ingresoEstimado.fijo)||0)+(Number(S.settings.ingresoEstimado.variable)||0);
  const disp=disponibleDe(s);
  const p=[];

  p.push(`<div class="pad stack" style="gap:20px">`);
  p.push(`<div class="monthnav">
    <button data-act="mes" data-d="-1" aria-label="Mes anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 6l-6 6 6 6"/></svg></button>
    <span class="h">${esc(monthLabel(S.monthKey))}</span>
    <button data-act="mes" data-d="1" aria-label="Mes siguiente">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 6l6 6-6 6"/></svg></button>
  </div>`);

  /* Los avisos de Resumen y la pantalla de Alertas salen de la misma función: lo que
     aparece acá arriba es, siempre, lo primero de esa lista. Se muestran como mucho dos,
     y se saltean los que apuntan al propio Resumen, porque eso ya se ve más abajo. */
  if(S.monthKey===monthKeyOf(todayISO())){
    const act=alertasActivas();
    const muestro=act.filter((a)=>a.nav!=="resumen").slice(0,2);
    muestro.forEach((a)=>p.push(alertaCard(a)));
    const resto=act.length-muestro.length;
    if(resto>0) p.push(`<button class="tiny" style="width:100%;text-align:center;color:${COL.acc};
      padding:9px 0;min-height:38px;margin-top:-12px" data-nav="alertas">${muestro.length
        ? (resto===1?"Ver 1 alerta más":`Ver las otras ${resto} alertas`)
        : (resto===1?"Ver la alerta":`Ver las ${resto} alertas`)}</button>`);
  }

  const catPairs=Object.entries(s.gastoPorCategoria).filter(([,v])=>v>0)
    .sort((a,b)=>b[1]-a[1]).map(([n,v])=>[n,v,categoryColor(n,S.settings)]);

  /* Un mes vacío muestra la misma estructura en cero, no un cartel. Al pasear por los meses,
     "andá a cargar un gasto" es un consejo fuera de lugar: no estás cargando nada, estás
     mirando. El único caso donde el cartel ayuda es la primera vez, sin un solo movimiento. */
  const primeraVez = !S.transactions.length && S.monthKey===monthKeyOf(todayISO());
  if(primeraVez){
    p.push(`<div class="empty">Todavía no cargaste ningún movimiento.<br>
      Andá a <strong>Chat</strong> y contame un gasto o un ingreso.</div>`);
  } else {
    p.push(`<div>${donutHTML(catPairs,s.totalGasto)}</div>`);

    /* Una cifra en cero no dice nada que valga una fila: se esconde. La excepción es el mes
       vacío, donde esconderlas todas dejaría la pantalla en blanco y lo que se quiere mostrar
       es justamente la estructura en cero. */
    const cifras=[
      ["Ingreso",s.totalIngreso,COL.in],
      ["Gasto neto",s.totalGasto,COL.out],
      ["Ahorro",s.totalAhorro,COL.acc],
      ["Inversión",s.totalInversion,COL.inv],
      ["Movido entre cuentas",s.totalTransferencia,"var(--ink-soft)"],
      ["Sin asignar",disp,disp<0?COL.out:"var(--ink)"],
    ];
    const hayAlgo=cifras.some(([,v])=>Math.round(v)!==0);
    const visibles=hayAlgo ? cifras.filter(([,v])=>Math.round(v)!==0) : cifras.slice(0,4).concat([cifras[5]]);
    p.push(`<div class="grid2">${visibles.map(([lbl,v,col])=>
      `<div class="stat"><div class="lbl">${esc(lbl)}</div>
        <div class="val" style="color:${col}">${nAnim(v)}</div></div>`).join("")}</div>`);

    /* Ahorro e inversión NO son gasto y no pueden vivir bajo un título que diga "Gasto":
       en esas dos, pasarse del objetivo es exactamente lo contrario de pasarse en una categoría
       de gasto. Van en su propio bloque, con el signo dado vuelta: superar la meta se pinta en
       verde y quedarse corto se dice como lo que falta, sin alarma. */
    const filaObjetivo=(r,bueno)=>{
      const conMeta = r.target>0;
      const pct = conMeta ? (r.actual/r.target)*100 : 0;
      const pasado = conMeta && r.actual>r.target;
      const corto = conMeta && r.actual<r.target;
      const colorCifra = pasado ? (bueno?COL.in:COL.out) : "";
      const colorBarra = pasado && !bueno ? COL.out : r.color;
      const clave=r.tipo+":"+r.name;
      const abierta=S.catAbierta===clave;
      const dets=abierta?movsDeCategoria(r.name,r.tipo):[];
      return `<div style="margin-bottom:11px">
        <button style="width:100%;text-align:left;display:block" data-act="cat" data-id="${esc(clave)}"
            aria-expanded="${abierta?"true":"false"}">
          <div class="leader"><span>${esc(r.name)}${
            (r.tipo==="gasto" && s.totalGasto>0)
              ? ` <span class="tiny muted">${Math.round(r.actual/s.totalGasto*100)}%</span>` : ""}</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="${COL.soft}" stroke-width="2.6"
              stroke-linecap="round" aria-hidden="true"
              style="flex:none;transform:rotate(${abierta?"90":"0"}deg)"><path d="M9 6l6 6-6 6"/></svg>
            <span class="fill"></span>
            <span class="num" style="${colorCifra?`color:${colorCifra}`:""}">${esc(shortV(r.actual))}</span>
            ${conMeta?`<span class="num muted tiny">/ ${esc(shortV(r.target))}</span>`
                     :`<span class="muted tiny">sin objetivo</span>`}
            ${pasado?`<span class="num tiny" style="color:${bueno?COL.in:COL.out};flex:none">+${esc(shortV(r.actual-r.target))}</span>`:""}
            ${(corto&&bueno)?`<span class="tiny muted" style="flex:none">faltan ${esc(shortV(r.target-r.actual))}</span>`:""}</div>
          ${conMeta
            ? `<div class="bar"><i style="width:${Math.min(100,pct).toFixed(1)}%;background:${colorBarra}"></i></div>`
            : `<div class="bar sin-meta"></div>`}
        </button>
        ${abierta?`<div class="cat-det" style="margin:4px 0 0;padding-left:10px;border-left:2px solid ${r.color}">
          ${dets.length
            ? `<div class="tiny muted" style="padding:6px 0 2px">${dets.length} movimiento${dets.length>1?"s":""} en ${esc(monthLabel(S.monthKey))}</div>`
              + dets.map((t)=>movRow(t,true)).join("")
            : `<div class="tiny muted" style="padding:8px 0">No hay movimientos sueltos detrás de este total.</div>`}
        </div>`:""}
      </div>`;
    };

    const gastos=S.settings.categoriasGasto
      .map((c)=>({name:c,tipo:"gasto",actual:s.gastoPorCategoria[c]||0,
        target:montoObjetivo(c,estim),color:categoryColor(c,S.settings)}))
      .filter((r)=>r.actual>0).sort((a,b)=>b.actual-a.actual);

    const aparte=[
      {name:"Ahorro",tipo:"ahorro",actual:s.totalAhorro,target:montoObjetivo("Ahorro",estim),color:COL.acc},
      {name:"Inversión",tipo:"inversion",actual:s.totalInversion,target:montoObjetivo("Inversión",estim),color:COL.inv},
    ].filter((r)=>r.actual>0).sort((a,b)=>b.actual-a.actual);

    /* Cada barra abre los movimientos que la componen: ver el número grande y no poder
       preguntarle de qué está hecho es la mitad de la información. */
    if(gastos.length) p.push(`<div><h2 class="sechead">Gasto vs. objetivo</h2>${
      gastos.map((r)=>filaObjetivo(r,false)).join("")}</div>`);

    if(aparte.length) p.push(`<div><h2 class="sechead">Ahorro e inversión</h2>${
      aparte.map((r)=>filaObjetivo(r,true)).join("")}
      <div class="tiny muted" style="margin-top:-4px">No cuentan como gasto: es plata tuya que
        apartaste. Acá pasarse del objetivo es a favor.</div></div>`);

    const ingRows=Object.entries(s.ingresoPorCategoria);
    if(ingRows.length) p.push(`<div><h2 class="sechead">Ingresos por concepto</h2>${
      ingRows.map(([n,v])=>`<div class="leader"><span>${esc(n)}</span><span class="fill"></span>
        <span class="num">${esc(fmtV(v))}</span></div>`).join("")}</div>`);

    if(sUSD.totalAhorro>0||sUSD.totalInversion>0) p.push(`<div class="card tiny muted">
      En dólares este mes — Ahorro: <span class="num">${esc(formatMoney(sUSD.totalAhorro,"USD"))}</span> ·
      Inversión: <span class="num">${esc(formatMoney(sUSD.totalInversion,"USD"))}</span></div>`);
  }
  p.push(`</div>`);
  $view.innerHTML=p.join("");
}

function lineChart(data){
  const W=358,H=170, padL=6,padR=46,padT=14,padB=22;
  const series=[
    {key:"Ingreso",color:COL.in,dash:""},
    {key:"Gasto",color:COL.out,dash:"5 3"},
    {key:"Ahorro",color:COL.acc,dash:"2 3"},
    {key:"Inversion",color:COL.inv,dash:"7 3 2 3"},
  ];
  const max=Math.max(1,...data.flatMap((d)=>series.map((s)=>d[s.key]||0)));
  const nice=Math.pow(10,Math.floor(Math.log10(max)));
  const top=Math.ceil(max/nice)*nice;
  const x=(i)=>padL+(i*(W-padL-padR)/Math.max(1,data.length-1));
  const y=(v)=>padT+(1-(v/top))*(H-padT-padB);

  const grid=[0,0.5,1].map((f)=>{
    const yy=padT+f*(H-padT-padB);
    const val=top*(1-f);
    return `<line x1="${padL}" y1="${yy.toFixed(1)}" x2="${W-padR}" y2="${yy.toFixed(1)}" stroke="${COL.line}" stroke-width="1"/>
      <text x="${W-padR+4}" y="${(yy+3.5).toFixed(1)}" fill="${COL.soft}" font-size="9" font-family="JetBrains Mono, monospace">${f===1?"0":shortV(val)}</text>`;
  }).join("");

  const lines=series.map((s)=>{
    const pts=data.map((d,i)=>`${x(i).toFixed(1)},${y(d[s.key]||0).toFixed(1)}`).join(" ");
    const last=data[data.length-1][s.key]||0;
    return `<polyline class="${s.dash?"fadein-tarde":"drawline"}" points="${pts}" fill="none" stroke="${s.color}" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round"${s.dash?` stroke-dasharray="${s.dash}"`:""}/>
      <circle cx="${x(data.length-1).toFixed(1)}" cy="${y(last).toFixed(1)}" r="3" fill="${s.color}"/>`;
  }).join("");

  /* Con muchos meses las etiquetas se pisan: se muestra una cada tantas, siempre la primera
     y la última, que son las que ubican el rango. */
  const paso=Math.max(1,Math.ceil(data.length/6));
  const xlabels=data.map((d,i)=>{
    const ultima=i===data.length-1;
    if(!(i===0 || ultima || i%paso===0)) return "";
    if(ultima===false && i!==0 && (data.length-1-i)<paso*0.6) return "";   // no pegada a la última
    return `<text x="${x(i).toFixed(1)}" y="${H-6}" fill="${COL.soft}" font-size="9.5"
      text-anchor="${i===0?"start":ultima?"end":"middle"}" font-family="Work Sans, sans-serif">${esc(d.label)}</text>`;
  }).join("");

  const legend=series.map((s)=>`<span class="it" style="flex:none">
    <svg width="18" height="6" aria-hidden="true"><line x1="0" y1="3" x2="18" y2="3" stroke="${s.color}"
      stroke-width="2"${s.dash?` stroke-dasharray="${s.dash}"`:""}/></svg>
    <span>${s.key==="Inversion"?"Inversión":s.key}</span></span>`).join("");

  return `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" role="img"
    aria-label="Evolución de ingreso, gasto, ahorro e inversión en los últimos 6 meses">
    ${grid}${lines}${xlabels}</svg>
    <div class="legend" style="flex-direction:row;flex-wrap:wrap;gap:12px;margin-top:8px">${legend}</div>`;
}

