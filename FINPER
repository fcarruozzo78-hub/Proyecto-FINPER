function renderDrawer(){
  const mkNow=monthKeyOf(todayISO());
  const s=computeMonthStats(movs(),mkNow).ARS;
  const guardado=s.totalAhorro+s.totalInversion;
  const estimMes=ingresoEstimado();
  const meta=montoObjetivo("Ahorro",estimMes)+montoObjetivo("Inversión",estimMes);
  const pct = meta>0 ? Math.min(100,Math.round(guardado/meta*100)) : 0;
