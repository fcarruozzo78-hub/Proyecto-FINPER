        <span class="opt-meta">${esc(fmtV(saldoDeCuenta(c.id),c.moneda))}</span></span></button>`).join("")}
      <button class="chip muted" style="width:100%" data-act="skip-cta" data-msg="${esc(m.id)}">Después lo asigno</button>
