const AL_CHECK=`<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l5 5 9-10"/></svg>`;
const AL_FAMILIAS=[
  ["tarjetas","Tarjetas","resúmenes por vencer y cierres"],
  ["fijos","Gastos fijos","los del mes que quedaron sin registrar"],
  ["objetivos","Objetivos","cuando una categoría se pasa de lo que te propusiste"],
  ["saldos","Cuentas","saldos en negativo y cotización vieja"],
];

function barra3(ya,comp,est,escala){
  const p=(v)=>escala>0?Math.max(0,Math.min(100,v/escala*100)):0;
  return `<div class="bar3" role="img" aria-label="Gasto: ${esc(shortV(ya))} hecho, ${esc(shortV(comp))} comprometido, ${esc(shortV(est))} estimado">
    <span style="width:${p(ya).toFixed(1)}%;background:${COL.out}"></span>
    <span style="width:${p(comp).toFixed(1)}%;background:${COL.acc}"></span>
    <span class="est" style="width:${p(est).toFixed(1)}%;background-color:${COL.soft}"></span>
  </div>`;
}
function filaProy(r){
  const pasa=r.objetivo>0 && r.proy>r.objetivo;
  const yaPaso=r.objetivo>0 && r.ya>r.objetivo;
  const esc2=Math.max(r.proy,r.objetivo);
  return `<div style="margin-top:13px">
    <div style="display:flex;align-items:baseline;gap:8px">
      <span class="dot" style="background:${categoryColor(r.cat,S.settings)};flex:none"></span>
      <span style="flex:1;min-width:0;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r.cat)}</span>
      <span class="num tiny" style="flex:none;color:${pasa?COL.out:"var(--ink)"}">${esc(shortV(r.proy))}</span>
      <span class="tiny muted" style="flex:none">${r.objetivo>0?"/ "+esc(shortV(r.objetivo)):"sin objetivo"}</span>
    </div>
    ${barra3(r.ya,r.comp,r.est,esc2)}
    <div class="tiny muted" style="margin-top:4px">${
      r.objetivo<=0 ? [r.ya>0.5?`${esc(shortV(r.ya))} gastado`:"",
                       r.comp>0.5?`${esc(shortV(r.comp))} comprometido`:"",
                       r.est>0.5?`${esc(shortV(r.est))} estimado`:""].filter(Boolean).join(" · ")
      : yaPaso ? `Ya te pasaste por ${esc(shortV(r.ya-r.objetivo))}`
      : pasa ? `A este ritmo te pasás por ${esc(shortV(r.proy-r.objetivo))}`
      : `Te quedarían ${esc(shortV(r.objetivo-r.proy))}`}</div>
  </div>`;
}

