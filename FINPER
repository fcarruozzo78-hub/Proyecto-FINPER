$view.addEventListener("click",(e)=>{
  const arco=e.target.closest("[data-arco]");
  if(arco){ pintarArco(arcoSel===arco.dataset.arco ? null : arco.dataset.arco); return; }
  /* tocar el centro o el hueco vuelve al total */
  if(arcoSel && e.target.closest(".donut")){ pintarArco(null); return; }
  const nav=e.target.closest("[data-nav]");
  if(nav){ navTo(nav.dataset.nav); return; }
  const alf=e.target.closest("[data-al]");
  if(alf){
    const cfg=alertaCfg(), k=alf.dataset.al;
    S.settings={...S.settings,alertas:{...cfg,[k]:!cfg[k]}};
    persistSettings(); render(); return;
  }
  const cuModo=e.target.closest('[data-cu="modo"]');
  if(cuModo && cuModo.dataset.v && S.cuentaForm){
    S.cuentaForm={...S.cuentaForm,modo:cuModo.dataset.v}; S.warn=""; render(); return;
  }
  const ald=e.target.closest("[data-aldias]");
  if(ald){
    S.settings={...S.settings,alertas:{...alertaCfg(),dias:Number(ald.dataset.aldias)||3}};
    persistSettings(); render(); return;
  }
  const b=e.target.closest("[data-act]"); if(!b) return;
  const act=b.dataset.act;

  if(act==="fj-new"){ S.fijoForm=nuevoFijoForm(); render(); return; }
  if(act==="fj-edit"){
    const f=S.fijos.find((x)=>x.id===b.dataset.id);
    if(f){ S.fijoForm={...f,monto:f.monto}; render(); }
    return;
  }
  if(act==="fj-cancel"){ S.fijoForm=null; S.warn=""; render(); return; }
  if(act==="fj-save"){ guardarFijo(); return; }
  if(act==="fj-del"){ borrarFijo(b.dataset.id); return; }
  if(act==="fj-reg"){
    const f=S.fijos.find((x)=>x.id===b.dataset.id);
    /* Si el monto cambia todos los meses, preguntarlo es el punto: asumirlo sería inventar. */
    if(f && f.variable){ S.fijoReg={id:f.id,valor:montoDeFijo(f)}; render(); return; }
    registrarFijos([b.dataset.id]); render(); return;
  }
  if(act==="fj-reg-cancel"){ S.fijoReg=null; render(); return; }
  if(act==="fj-reg-ok"){
    const inp=document.getElementById("fjreg");
    const v=inp?numAR(inp.value):NaN;
    if(isNaN(v)||v<=0){ showWarn("Necesito el monto de este mes para registrarlo."); return; }
    const id=b.dataset.id; S.fijoReg=null;
    registrarFijos([id],{[id]:Math.abs(v)}); render(); return;
  }
  if(act==="fj-reg-all"){ registrarFijos(fijosPendientes().filter((f)=>!f.variable).map((f)=>f.id)); render(); return; }
  if(act==="fj-undo"){ desmarcarFijo(b.dataset.id); return; }

  if(act==="tj-new"){ S.tarjetaForm=nuevaTarjetaForm(); S.compraForm=null; render(); return; }
  if(act==="tj-edit"){
    const t=tarjetaById(b.dataset.id);
    if(t){ S.tarjetaForm={...t}; S.compraForm=null; render(); }
    return;
  }
  if(act==="tj-cancel"){ S.tarjetaForm=null; S.warn=""; render(); return; }
  if(act==="tj-save"){ guardarTarjeta(); return; }
  if(act==="tj-del"){ borrarTarjeta(b.dataset.id); return; }
  if(act==="tj-pay"){
    const tj=tarjetaById(b.dataset.tj);
    S.pagoId=b.dataset.tj+"|"+b.dataset.c;
    S.pagoCuenta=(tj&&tj.cuentaPago)||cuentaDefaultValida(S.settings)||"";
    render(); return;
  }
  if(act==="tj-pay-cancel"){ S.pagoId=null; S.pagoCuenta=""; render(); return; }
  if(act==="tj-pay-ok"){ pagarResumen(b.dataset.tj,b.dataset.c); return; }
  if(act==="tj-unpay"){ desmarcarPago(b.dataset.tj,b.dataset.c); return; }

  if(act==="cp-new"){ S.compraForm=nuevaCompraForm(); S.tarjetaForm=null; render(); return; }
  if(act==="cp-edit"){
    const cp=S.compras.find((x)=>x.id===b.dataset.id);
    if(cp){
      S.compraForm={...cp};
      S.tarjetaForm=null;
      if(S.tab!=="tarjetas"){ S.tab="tarjetas"; S.entrada=true; S.saldoAnim=false; }
      render();
    }
    return;
  }
  if(act==="cp-cancel"){ S.compraForm=null; S.warn=""; render(); return; }
  if(act==="cp-save"){ guardarCompra(); return; }
  if(act==="cp-del"){ borrarCompra(b.dataset.id); return; }

  if(act==="cot-edit"){ S.cotForm=true; render(); return; }
  if(act==="cot-cancel"){ S.cotForm=false; render(); return; }
  if(act==="cot-save"){
    const inp=document.getElementById("cot-val");
    guardarCotizacion(inp?inp.value:"");
    return;
  }

  if(act==="cu-new"){ S.cuentaForm=nuevaCuentaForm(); S.concId=null; render(); return; }
  if(act==="cu-cero"){ cuentaDesdeCero(b.dataset.id); return; }
  if(act==="cu-edit"){
    const c=cuentaById(b.dataset.id);
    if(c){ S.cuentaForm={...c,saldoInicial:c.saldoInicial,
      modo:(!Number(c.saldoInicial) && Number(c.fotoTs)===1) ? "cero" : "foto"};
      S.concId=null; render(); }
    return;
  }
  if(act==="cu-cancel"){ S.cuentaForm=null; S.warn=""; render(); return; }
  if(act==="cu-save"){ guardarCuenta(); return; }
  if(act==="cu-del"){ borrarCuenta(b.dataset.id); return; }
  if(act==="cu-open"){
    S.concId = S.concId===b.dataset.id ? null : b.dataset.id;
    S.concValor="";
    const y=$view.scrollTop; render(); $view.scrollTop=y;
    return;
  }
  if(act==="cu-conc"){
    const inp=document.getElementById("conc-"+b.dataset.id);
    S.concValor = inp ? inp.value : "";
    conciliar(b.dataset.id);
    return;
  }

  if(act==="example"){ S.draft=b.textContent.trim(); $msg.value=S.draft; $msg.focus(); return; }
  if(act==="mes"){ S.monthKey=shiftMonth(S.monthKey,Number(b.dataset.d)); S.entrada=true;
    S.catAbierta=null; closeEditor(); render(); return; }
  if(act==="edit"){ openEditor(b.dataset.id,b.dataset.msg); render(); return; }
  if(act==="cancel-ed"){ closeEditor(); render(); return; }
  if(act==="save-ed"){ saveEditor(); return; }
  if(act==="ed-fijo"){ fijoDesdeMovimiento(b.dataset.id); return; }
  if(act==="del-tx"){ if(S.editForm) deleteTx(S.editForm.id); return; }
  if(act==="rm-reemb"){
    if(!S.editForm) return;
    S.editForm={...S.editForm,reembolsos:S.editForm.reembolsos.filter((r)=>r.id!==b.dataset.id)};
    render(); return;
  }
  if(act==="set-cta"){ asignarCuenta(b.dataset.msg,b.dataset.k,b.dataset.id); return; }
  if(act==="skip-cta"){ omitirCuenta(b.dataset.msg); return; }
  if(act==="cat"){
    const clave=b.dataset.id;
    const cerrando = S.catAbierta===clave;
    const panel = b.parentElement && b.parentElement.querySelector(".cat-det");
    const aplicar=()=>{
      S.catAbierta = cerrando ? null : clave;
      closeEditor();
      /* Al redibujar la pantalla el navegador vuelve arriba: si la categoría estaba abajo,
         abrirla te sacaba de donde estabas. */
      const y=$view.scrollTop; render(); $view.scrollTop=y;
      if(!cerrando) animarDespliegue($view.querySelector(".cat-det"));
    };
    /* Cambiar de una categoría a otra cierra la anterior de una: el ojo sigue a la que se
       abre, y encadenar las dos animaciones haría que el toque se sienta lento. */
    if(cerrando) animarPliegue(panel,aplicar); else aplicar();
    return;
  }
  if(act==="filtro-sc"){ S.soloSinCuenta=!S.soloSinCuenta; S.entrada=true; closeEditor(); render(); return; }
  if(act==="choose"){ resolveChooser(b.dataset.msg,b.dataset.id||null); return; }
  if(act==="multi-open"){
    const msg=S.messages.find((m)=>m.id===b.dataset.msg); if(!msg) return;
    const i=Number(b.dataset.i);
    S.messages=S.messages.map((m)=>m.id===msg.id
      ?{...m,filas:m.filas.map((f,k)=>k===i?{...f,abrir:true}:f)}:m);
    render(); return;
  }
  if(act==="multi-pick"){
    const msg=S.messages.find((m)=>m.id===b.dataset.msg); if(!msg) return;
    const i=Number(b.dataset.i), id=b.dataset.id;
    const filas=msg.filas.map((f,k)=>k===i?{...f,txId:id==="omit"?null:id,abrir:id==="omit"}:f);
    S.messages=S.messages.map((m)=>m.id===msg.id?{...m,filas}:m);
    /* al cambiar de gasto, la propuesta se rehace: los topes son otros */
    recalcularReparto(msg.id);
    render(); return;
  }
  if(act==="multi-ok"){ confirmMulti(b.dataset.msg); return; }
  if(act==="cancel-reemb"){
    S.pendingReembolso=null;
    setMessages(S.messages.map((m)=>m.id===b.dataset.msg
      ?{id:m.id,role:"assistant",kind:"text",ts:Date.now(),text:"Listo, no registré nada."}:m));
    render(); return;
  }
  if(act==="csv"){ exportCSV(); return; }
  if(act==="reset"){
    if(b.dataset.confirm==="1"){ resetAll(); return; }
    b.dataset.confirm="1"; b.textContent="¿Seguro? Tocá de nuevo"; return;
  }
  if(act==="hist"){
    const m=b.dataset.m;
    const h=S.settings.hist||{modo:"6"};
    const hoyMes=monthKeyOf(todayISO());
    S.settings={...S.settings,hist: m==="custom"
      ? {modo:"custom",desde:h.desde||shiftMonth(hoyMes,-5),hasta:h.hasta||hoyMes}
      : {modo:m}};
    persistSettings(); S.entrada=true; render(); return;
  }
  if(act==="obj-modo"){
    const cat=b.dataset.id, o=objetivoDe(cat), estim=ingresoEstimado();
    /* Al cambiar de unidad se convierte el valor en vez de arrancar de cero: pasar de
       "25%" a plata debería dejar ya escrito lo que ese 25% representa. */
    if(o.tipo==="pct") setObjetivo(cat,"monto",Math.round(estim*o.valor/100));
    else setObjetivo(cat,"pct", estim>0 ? Math.round(o.valor/estim*1000)/10 : 0);
    render(); return;
  }
  if(act==="add-cat"){
    const inp=document.getElementById("cf-newcat");
    const name=(inp&&inp.value||"").trim();
    if(!name||S.settings.categoriasGasto.includes(name)) return;
    S.settings={...S.settings,categoriasGasto:[...S.settings.categoriasGasto,name],
      objetivos:{...S.settings.objetivos,[name]:0}};
    persistSettings(); render(); return;
  }
  if(act==="rm-cat"){
    const name=b.dataset.id;
    const obj={...S.settings.objetivos}; delete obj[name];
    S.settings={...S.settings,categoriasGasto:S.settings.categoriasGasto.filter((c)=>c!==name),objetivos:obj};
    persistSettings(); render(); return;
  }
});

/* Con mouse alcanza con pasar por encima. Va con eventos de puntero y filtrando por tipo
   porque Safari en iPhone dispara un mouseover sintético JUSTO ANTES del click: el mouseover
   elegía la porción y el click que venía atrás la apagaba, así que el primer toque no hacía
   nada visible y había que tocar dos veces. */
$view.addEventListener("pointerover",(e)=>{
  if(e.pointerType!=="mouse") return;
  const arco=e.target.closest("[data-arco]");
  if(arco && arcoSel!==arco.dataset.arco) pintarArco(arco.dataset.arco);
});
$view.addEventListener("pointerout",(e)=>{
  if(e.pointerType!=="mouse") return;
  const d=e.target.closest(".donut");
  if(d && !d.contains(e.relatedTarget)) pintarArco(null);
});

/* Los montos del reparto se escriben sin redibujar —redibujar cerraría el teclado— así que
   el pie con el total se actualiza a mano, sobre el nodo que ya está en pantalla. */
$view.addEventListener("input",(e)=>{
  const t=e.target;
  if(t.dataset.rp===undefined || !t.dataset.msg) return;
  const msg=S.messages.find((m)=>m.id===t.dataset.msg); if(!msg) return;
  const i=Number(t.dataset.rp);
  const v=numAR(t.value);
  let filas=msg.filas.map((f,k)=>k===i?{...f,monto:isNaN(v)?0:Math.abs(v),tocado:true}:f);
  const total=Math.abs(Number(msg.parsed.monto)||0);
  /* Si alguna fila es "el resto" y el usuario no la tocó, se reajusta sola: para eso la
     nombró así. Mover una cifra no debería obligarlo a recalcular la otra a mano. */
  const j=filas.findIndex((f,k)=>k!==i && f.spec && f.spec.resto && !f.tocado && f.txId);
  if(j>=0){
    const otros=filas.reduce((a,f,k)=>k===j?a:a+(Number(f.monto)||0),0);
    const tx=txById(filas[j].txId);
    const val=Math.max(0,Math.min(Math.round((total-otros)*100)/100, tx?saldoAbierto(tx):0));
    filas=filas.map((f,k)=>k===j?{...f,monto:val}:f);
    const inp=$view.querySelector(`[data-msg="${msg.id}"][data-rp="${j}"]`);
    if(inp && document.activeElement!==inp) inp.value=montoTxt(val);
  }
  S.messages=S.messages.map((m)=>m.id===msg.id?{...m,filas}:m);
  const pie=document.getElementById("rp-tot-"+msg.id);
  if(pie){
    const total=Math.abs(Number(msg.parsed.monto)||0), suma=sumaReparto({...msg,filas});
    pie.textContent=repartoPie(total,suma,msg.parsed.moneda);
    pie.style.color = Math.abs(total-suma)<0.01 ? COL.soft : COL.acc;
  }
});

$view.addEventListener("change",(e)=>{
  const t=e.target;
  if(t.dataset.cu && S.cuentaForm){
    S.cuentaForm={...S.cuentaForm,[t.dataset.cu]:t.value};
    if(t.dataset.cu==="tipo"||t.dataset.cu==="moneda") render();
    return;
  }
  if(t.dataset.tj && S.tarjetaForm){
    S.tarjetaForm={...S.tarjetaForm,[t.dataset.tj]:t.value};
    if(t.dataset.tj==="moneda"||t.dataset.tj==="cuentaPago") render();
    return;
  }
  if(t.dataset.cp && S.compraForm){
    S.compraForm={...S.compraForm,[t.dataset.cp]:t.value};
    if(t.dataset.cp==="tarjeta"){
      const tj=tarjetaById(t.value);
      if(tj) S.compraForm.moneda=tj.moneda||"ARS";
    }
    /* Los campos de texto no redibujan: si lo hicieran, al saltar de uno al otro se
       reemplazaría el formulario debajo del dedo y se cerraría el teclado. */
    if(["tarjeta","moneda","categoria","cuotas","fecha"].includes(t.dataset.cp)) render();
    return;
  }
  if(t.dataset.pg){ S.pagoCuenta=t.value; return; }
  if(t.dataset.hr){
    const h=S.settings.hist||{modo:"custom"};
    S.settings={...S.settings,hist:{...h,modo:"custom",[t.dataset.hr]:t.value}};
    persistSettings(); S.entrada=true; render(); return;
  }
  if(t.dataset.fj && S.fijoForm){
    const k=t.dataset.fj;
    S.fijoForm={...S.fijoForm,[k]:k==="variable"?t.checked:t.value};
    if(["moneda","categoria","cuenta","variable"].includes(k)) render();
    return;
  }
  if(t.dataset.ed && S.editForm){
    const k=t.dataset.ed;
    const v = (k==="esCompartido"||k==="puntual") ? t.checked : t.value;
    S.editForm={...S.editForm,[k]:v};
    if(k==="tipo"){
      const cats = v==="gasto"?S.settings.categoriasGasto : v==="ingreso"?S.settings.categoriasIngreso
        : v==="ahorro"?["Ahorro"] : v==="transferencia"?["Transferencia"]:["Inversión"];
      if(!cats.includes(S.editForm.categoria)) S.editForm.categoria=cats[0];
    }
    render(); return;
  }
  if(t.dataset.cf){
    const k=t.dataset.cf;
    if(k==="cotizacionUSD"){ guardarCotizacion(t.value); return; }
    else if(k==="cuentaDefault") S.settings={...S.settings,cuentaDefault:t.value};
    else if(k==="preguntarCuenta") S.settings={...S.settings,preguntarCuenta:t.value};
    else S.settings={...S.settings,ingresoEstimado:{...S.settings.ingresoEstimado,[k]:(isNaN(numAR(t.value))?0:numAR(t.value))}};
    persistSettings(); render(); return;
  }
  if(t.dataset.obj){
    const cat=t.dataset.obj, modo=objetivoDe(cat).tipo;
    const v = modo==="monto" ? (isNaN(numAR(t.value))?0:numAR(t.value)) : t.value;
    setObjetivo(cat,modo,v); render(); return;
  }
});

/* ===================== arranque ===================== */

/* La bienvenida dura lo que tarda el trazo del logo, y hace de pantalla de carga:
   se va cuando terminó la animación Y ya están los datos, lo que pase último. */
const $splash=document.getElementById("splash");
const sinMovimiento = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const splashMin = new Promise((r)=>setTimeout(r, sinMovimiento?450:2050));
let splashIdo=false;
function cerrarSplash(){
  if(splashIdo) return;
  splashIdo=true;
  $splash.classList.add("gone");
  setTimeout(()=>{ $splash.hidden=true; }, sinMovimiento?0:300);
  /* La entrada arranca cuando se levanta el logo, no antes: si no, la animación
     pasaría detrás de la bienvenida y no la verías. */
  if(S.loaded){ S.entrada=true; S.saldoAnim=true; render(); }
}
$splash.addEventListener("click",cerrarSplash);

render();

(async function boot(){
  const w=window.claude;
  if(w && w.use){
    try{ S.sample=await w.use("sample"); }catch(e){}
    try{ S.downloads=await w.use("downloads"); }catch(e){}
    try{ S.db=await w.use("db"); }catch(e){}
  }
  if(S.db){ await loadAll(); }
  else { S.warn="No pude conectarme al guardado, así que lo que cargues ahora no va a quedar guardado. Probá recargar la página."; }
  if(!S.sample && !S.warn){
    S.warn="La IA no está disponible en esta vista, así que no puedo interpretar mensajes. Podés mirar tus datos igual.";
  }
  S.loaded=true;
  S.entrada=splashIdo; S.saldoAnim=splashIdo;
  render();
  await splashMin;
  cerrarSplash();
})();
</script>
