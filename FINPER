function patrimonioChart(data){
  const W=358,H=112,padL=4,padR=52,padT=12,padB=18;
  const vals=data.map((d)=>d.total);
  const hi=Math.max(...vals), lo=Math.min(...vals);
  const top=hi>0?hi*1.08:1, bot=lo<0?lo*1.08:0;
  const x=(i)=>padL+(i*(W-padL-padR)/Math.max(1,data.length-1));
  const y=(v)=>padT+(1-((v-bot)/((top-bot)||1)))*(H-padT-padB);
  const pts=data.map((d,i)=>`${x(i).toFixed(1)},${y(d.total).toFixed(1)}`).join(" ");
  const area=`${padL},${y(bot).toFixed(1)} ${pts} ${x(data.length-1).toFixed(1)},${y(bot).toFixed(1)}`;
  const last=data[data.length-1];
  return `<svg viewBox="0 0 ${W} ${H}" width="100%" height="${H}" role="img"
      aria-label="Evolución del patrimonio en los últimos 6 meses">
    <line x1="${padL}" y1="${y(top).toFixed(1)}" x2="${W-padR}" y2="${y(top).toFixed(1)}" stroke="${COL.line}" stroke-width="1"/>
    <text x="${W-padR+4}" y="${(y(top)+3.5).toFixed(1)}" fill="${COL.soft}" font-size="9"
      font-family="JetBrains Mono, monospace">${esc(shortV(top))}</text>
    <polygon class="fadein" points="${area}" fill="${COL.acc}" fill-opacity="0.13"/>
    <polyline class="drawline" points="${pts}" fill="none" stroke="${COL.acc}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="${x(data.length-1).toFixed(1)}" cy="${y(last.total).toFixed(1)}" r="3.4" fill="${COL.acc}"/>
    ${data.map((d,i)=>`<text x="${x(i).toFixed(1)}" y="${H-5}" fill="${COL.soft}" font-size="9.5"
      text-anchor="${i===0?"start":i===data.length-1?"end":"middle"}"
      font-family="Work Sans, sans-serif">${esc(d.label)}</text>`).join("")}
  </svg>`;
}

function cuentaRow(c){
  const saldo=saldoDeCuenta(c.id);
  const abierta=S.concId===c.id;
  const v=vista();
  const distinta = (c.moneda||"ARS")!==v;
  return `<div>
    <button class="mvrow" style="width:100%;text-align:left" data-act="cu-open" data-id="${esc(c.id)}"
        aria-expanded="${abierta?"true":"false"}">
      <span class="dot" style="background:${c.tipo==="inversion"?COL.inv:COL.acc}"></span>
      <span class="t">${esc(c.nombre)}</span>
      <span class="num" style="text-align:right">${esc(fmtV(saldo,c.moneda))}${
        distinta?`<br><span class="tiny muted">${esc(formatMoney(saldo,c.moneda))}</span>`:""}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="${COL.soft}" stroke-width="2.2"
        stroke-linecap="round" style="flex:none;transform:rotate(${abierta?"90":"0"}deg)" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </button>
    ${abierta?`<div class="card stack" style="gap:10px;margin:2px 0 10px">
      ${esDesdeCero(c)
        ? `<div class="leader"><span>Se calcula desde cero</span><span class="fill"></span></div>
           <div class="leader"><span class="muted tiny">suma todo lo cargado, sin saldo de partida</span></div>`
        : `<div class="leader"><span>Saldo de partida</span><span class="fill"></span>
             <span class="num">${esc(formatMoney(c.saldoInicial,c.moneda))}</span></div>
           <div class="leader"><span class="muted tiny">desde ${esc(formatFecha(c.desde))}</span></div>`}
      <div class="field"><label for="conc-${esc(c.id)}">¿Cuánto tenés realmente ahora?</label>
        <div style="display:flex;gap:8px">
          <input id="conc-${esc(c.id)}" type="text" inputmode="decimal" autocomplete="off"
            placeholder="${esc(montoTxt(saldo)||"0")}">
          <button class="solid" style="flex:none" data-act="cu-conc" data-id="${esc(c.id)}">Conciliar</button>
        </div></div>
      <div class="tiny muted">Si no coincide con el saldo calculado, anoto la diferencia como un ajuste.</div>
      ${(()=>{ const tap=movsTapadosPorFoto(c);
        if(!tap.length) return "";
        return `<div class="card" style="border-color:${COL.acc};background:var(--accent-bg);padding:11px 12px">
          <div style="font-size:12.5px;line-height:1.5">
            <strong>${tap.length} ${tap.length===1?"movimiento queda tapado":"movimientos quedan tapados"}</strong>
            por el saldo de partida: se consideran ya incluidos en él y no mueven el saldo.
            Si cargaste esos movimientos antes de crear la cuenta, conviene calcularla desde cero;
            si no, una devolución que anotes después sobre alguno de ellos puede sumar plata que ya estaba.</div>
          <button class="solid" style="margin-top:10px;width:100%" data-act="cu-cero" data-id="${esc(c.id)}"
            >Calcular desde los movimientos</button>
        </div>`; })()}
      <div style="display:flex;gap:8px">
        <button class="chip" data-act="cu-edit" data-id="${esc(c.id)}">Editar cuenta</button>
      </div>
    </div>`:""}
  </div>`;
}

function renderPatrimonio(){
  const p=patrimonio();
  const liqTotal=aPesos(p.liq.ARS,p.liq.USD);
  const invTotal=aPesos(p.inv.ARS,p.inv.USD);
  const liquidas=cuentasActivas().filter((c)=>c.tipo!=="inversion");
  const inversiones=cuentasActivas().filter((c)=>c.tipo==="inversion");
  const hist=patrimonioHistorial();
  const hayCurva=new Set(hist.map((h)=>Math.round(h.total))).size>1;
  const out=[`<div class="pad stack" style="gap:18px">`];

  if(!cuentasActivas().length && !S.cuentaForm){
    out.push(`<div><h2 class="h" style="font-size:16px;margin:0 0 4px">Patrimonio</h2>
      <div class="tiny muted">Cuánto tenés, no cuánto gastaste</div></div>`);
    out.push(`<div class="empty">Cargá tus cuentas —Mercado Pago, el banco, efectivo, los dólares que tengas
      guardados— con el saldo que tienen hoy.<br><br>Desde ahí la app los va actualizando sola con cada
      movimiento, y vas a poder ver tu patrimonio total y cómo evoluciona mes a mes.</div>`);
    out.push(`<button class="solid" data-act="cu-new" style="width:100%">+ Agregar mi primera cuenta</button>`);
    out.push(`</div>`);
    $view.innerHTML=out.join("");
    return;
  }

  out.push(`<div>
    <div class="tiny muted" style="text-transform:uppercase;letter-spacing:.06em">${
      p.deudaTotal?"Patrimonio neto":"Patrimonio total"}</div>
    <div class="num" style="font-size:30px;font-weight:700;line-height:1.15;margin:2px 0 5px">${nAnim(p.total)}</div>
    <div class="tiny muted">disponible <span class="num" style="color:${COL.acc}">${nAnim(liqTotal,"ARS","short")}</span>
      · invertido <span class="num" style="color:${COL.inv}">${nAnim(invTotal,"ARS","short")}</span>${
      p.deudaTotal?` · tarjetas <span class="num" style="color:${COL.out}">−${nAnim(p.deudaTotal,"ARS","short")}</span>`:""}</div>
    ${p.deudaTotal?`<div class="tiny muted" style="margin-top:5px">Lo que compraste con tarjeta y todavía no pagaste
      ya no es plata tuya, así que se resta.</div>`:""}
    ${p.faltaCotizacion?`<div class="banner" style="margin:11px 0 0">Tenés ${esc(formatMoney(p.usdTotal,"USD"))}
      en dólares pero no cargaste la cotización, así que no están sumados en el total.
      <button data-act="cot-edit" style="color:var(--ink);text-decoration:underline">Cargala acá</button>.</div>`:""}
    ${(cotizacion() && !S.cotForm)?`<div class="tiny" style="margin-top:9px;display:flex;align-items:center;gap:7px;flex-wrap:wrap">
      <span class="muted">Dólar a <span class="num">${esc(formatMoney(cotizacion(),"ARS"))}</span></span>
      <span style="color:${cotizacionVieja()?COL.acc:"var(--ink-soft)"}">· ${esc(cotizacionEdad())}</span>
      <button data-act="cot-edit" style="color:${COL.acc};font-weight:600">actualizar</button>
    </div>`:""}
    ${S.cotForm?`<div class="card stack" style="gap:9px;margin-top:11px">
      <div class="field"><label for="cot-val">Cotización del dólar</label>
        <div style="display:flex;gap:8px">
          <input id="cot-val" type="text" inputmode="decimal" autocomplete="off" placeholder="ej: 1.535,43" value="${esc(montoTxt(cotizacion()))}">
          <button class="solid" style="flex:none" data-act="cot-save">Guardar</button>
        </div></div>
      <div class="tiny muted">Si tenés dólares billete, conviene valuarlos al blue o al MEP y no al oficial:
        al oficial tu patrimonio queda subestimado. Preguntame la cotización del día cuando quieras y te la paso.</div>
      <div><button class="chip" data-act="cot-cancel">Cancelar</button></div>
    </div>`:""}
  </div>`);

  if(hayCurva) out.push(`<div>${patrimonioChart(hist)}</div>`);
  else out.push(`<div class="tiny muted">La curva de evolución se va a ir dibujando a medida que pasen los meses.</div>`);

  if(S.cuentaForm) out.push(cuentaFormHTML());

  if(liquidas.length) out.push(`<div><h3 class="sechead">Disponible</h3>${liquidas.map(cuentaRow).join("")}</div>`);
  if(inversiones.length || p.sinC.ARS || p.sinC.USD){
    out.push(`<div><h3 class="sechead">Invertido y ahorrado</h3>${inversiones.map(cuentaRow).join("")}
      ${(p.sinC.ARS||p.sinC.USD)?`<div class="mvrow">
        <span class="dot" style="background:${COL.soft}"></span>
        <span class="t muted">Ahorro sin cuenta asignada</span>
        <span class="num muted">${esc(fmtV(p.sinC.ARS))}${p.sinC.USD?` + ${esc(formatMoney(p.sinC.USD,"USD"))}`:""}</span>
      </div>
      <div class="tiny muted" style="margin-top:6px">Es plata que apartaste sin decir a dónde fue. Si creás la
        cuenta y la mencionás al cargar el movimiento, se va a ordenar sola.</div>`:""}</div>`);
  }

  if(p.deudaTotal){
    out.push(`<div><h3 class="sechead">Deuda de tarjetas</h3>${tarjetasActivas().map((tj)=>{
      const d=ciclosDeTarjeta(tj.id).filter((c)=>!cicloPagado(tj,c))
        .reduce((a,c)=>a+totalCiclo(tj.id,c),0);
      if(!d) return "";
      return `<button class="mvrow" style="width:100%;text-align:left" data-nav="tarjetas">
        <span class="dot" style="background:${COL.out}"></span>
        <span class="t">${esc(tj.nombre)}</span>
        <span class="num" style="color:${COL.out}">−${esc(fmtV(d,tj.moneda))}</span>
      </button>`;}).join("")}</div>`);
  }

  if(!S.cuentaForm) out.push(`<button class="chip" data-act="cu-new" style="width:100%">+ Agregar cuenta</button>`);
  out.push(`</div>`);
  $view.innerHTML=out.join("");
}

function renderHistorial(){
  const h=S.settings.hist||{modo:"6"};
  const keys=mesesDelRango();
  const data=computeHistorial(movs(),keys);
  const anyData=data.some((d)=>d.Ingreso||d.Gasto||d.Ahorro||d.Inversion);
  const hoyMes=monthKeyOf(todayISO());
  const p=[`<div class="pad stack" style="gap:18px">`];

  p.push(`<div>
    <h2 class="h" style="font-size:16px;margin:0 0 3px">Evolución</h2>
    <div class="tiny muted">${esc(etiquetaRango(keys))} · ${keys.length} mes${keys.length===1?"":"es"}</div>
  </div>`);

  p.push(`<div class="seg" role="group" aria-label="Período del historial">
    ${[["3","3m"],["6","6m"],["12","12m"],["todo","Todo"],["custom","Rango"]].map(([m,txt])=>
      `<button data-act="hist" data-m="${m}" aria-pressed="${h.modo===m?"true":"false"}">${txt}</button>`).join("")}
  </div>`);

  if(h.modo==="custom"){
    /* Uno por fila: el selector de mes del sistema tiene un ancho mínimo propio (~207px)
       y dos no entran a lo ancho de un teléfono. */
    p.push(`<div class="stack" style="gap:10px">
      <div class="field"><label for="h-desde">Desde</label>
        <input id="h-desde" data-hr="desde" type="month" value="${esc(h.desde||shiftMonth(hoyMes,-5))}"></div>
      <div class="field"><label for="h-hasta">Hasta</label>
        <input id="h-hasta" data-hr="hasta" type="month" value="${esc(h.hasta||hoyMes)}"></div>
    </div>`);
  }

  if(!anyData){
    p.push(`<div class="empty">No hay movimientos en este período.<br>Probá con otro rango, o cargá algunos y acá vas a ver la evolución mes a mes.</div>`);
  } else {
    p.push(`<div>${lineChart(data)}</div>`);
    p.push(`<div><h2 class="sechead">Detalle mensual</h2><div class="stack" style="gap:9px">${
      [...data].reverse().map((r)=>{
        const tasa = r.Ingreso>0 ? Math.round(((r.Ahorro+r.Inversion)/r.Ingreso)*100) : 0;
        return `<div class="card">
          <div class="h" style="font-size:12.5px;margin-bottom:4px">${esc(monthLabel(r.mes))}</div>
          <div class="leader"><span>Ingreso</span><span class="fill"></span><span class="num">${esc(fmtV(r.Ingreso))}</span></div>
          <div class="leader"><span>Gasto</span><span class="fill"></span><span class="num">${esc(fmtV(r.Gasto))}</span></div>
          <div class="leader"><span>Ahorro + Inversión</span><span class="fill"></span><span class="num">${esc(fmtV(r.Ahorro+r.Inversion))}</span></div>
          <div class="leader"><span>Tasa de ahorro</span><span class="fill"></span><span class="num" style="color:${tasa>0?COL.in:"var(--ink)"}">${tasa}%</span></div>
        </div>`;}).join("")}</div></div>`);
  }
  p.push(`</div>`);
  $view.innerHTML=p.join("");
}

function renderConfig(){
  const st=S.settings;
  const estim=ingresoEstimado(st);
  /* Con objetivos mixtos (unos en % y otros en plata) sumar porcentajes no dice nada:
     lo que se compara es cuánta plata está comprometida contra el ingreso estimado. */
  const comprometido=[...st.categoriasGasto,"Ahorro","Inversión"]
    .reduce((a,c)=>a+montoObjetivo(c,estim,st),0);
  const pctTotal = estim>0 ? Math.round(comprometido/estim*100) : 0;
  const p=[`<div class="pad stack" style="gap:26px">`];

  p.push(`<div class="stack" style="gap:11px">
    <h2 class="h" style="font-size:16px;margin:0">Ingreso mensual estimado</h2>
