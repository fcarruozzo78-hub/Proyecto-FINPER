/* Cuando un gasto ya tiene devoluciones, mostrar solo lo pendiente esconde justo el dato con
   el que uno lo reconoce: dos compras en el mismo lugar se distinguen por lo que salieron, no
   por lo que falta cobrar. Van los dos números. */
function optMeta(tx){
  const reemb=sumReembolsos(tx);
  const pend=tx.monto-reemb;
  return reemb>0
    ? `<span class="num">${esc(formatMoney(tx.monto,tx.moneda))}</span> · quedan `
      + `<span class="num">${esc(formatMoney(pend,tx.moneda))}</span> · ${esc(formatFecha(tx.fecha))}`
    : `<span class="num">${esc(formatMoney(pend,tx.moneda))}</span> · ${esc(formatFecha(tx.fecha))}`;
}
function optHTML(tx,mode){
  const main = mode==="correccion"
    ? `${TIPO_LABEL[tx.tipo]||tx.tipo} — ${tx.categoria}${tx.descripcion?" · "+tx.descripcion:""}`
    : (tx.descripcion||tx.categoria);
  const meta = mode==="correccion"
    ? `<span class="num">${esc(formatMoney(tx.monto,tx.moneda))}</span> · ${esc(formatFecha(tx.fecha))}`
    : optMeta(tx);
  return `<span class="opt"><span class="opt-main">${esc(main)}</span><span class="opt-meta">${meta}</span></span>`;
}

/* El saldo al lado de cada cuenta no es decoración: es lo que te deja decidir de cuál
   descontarlo sin salir del chat. */
function cuentaPickerHTML(m,tx){
  const k=(m.pedir||[])[0];
  if(!k) return "";
  const pregunta=(PREGUNTA_CUENTA[tx.tipo]||{})[k];
  const lista=opcionesDeSlot(tx,k);
  if(!pregunta || !lista.length) return "";
  return `<div style="margin-top:10px">
    <div class="tiny" style="margin-bottom:6px;color:${COL.acc};font-weight:600">${esc(pregunta)}</div>
    <div class="stack" style="gap:6px">
      ${lista.map((c)=>`<button class="chip${tx[k]===c.id?" on":""}" style="width:100%"
          data-act="set-cta" data-msg="${esc(m.id)}" data-k="${esc(k)}" data-id="${esc(c.id)}">
