function cuentasActivas(){ return S.cuentas.filter((c)=>!c.archivada); }
function cuentaById(id){ return S.cuentas.find((c)=>c.id===id)||null; }
function cuentaNombre(id){ const c=cuentaById(id); return c?c.nombre:""; }

/* Busca una cuenta por el nombre que escribió el usuario o devolvió la IA. */
function matchCuenta(nombre){
  if(!nombre) return null;
  const n=normalize(nombre);
  if(!n) return null;
  const exacta=cuentasActivas().find((c)=>normalize(c.nombre)===n);
  if(exacta) return exacta.id;
  const parcial=cuentasActivas().find((c)=>{
    const cn=normalize(c.nombre);
    return cn.includes(n)||n.includes(cn);
  });
  return parcial?parcial.id:null;
}

/* Un movimiento puede estar en una moneda y la cuenta en otra (comprar dólares desde
   una cuenta en pesos, por ejemplo): ahí hay que convertir, no sumar el número crudo.
   Sin cotización cargada no inventamos nada: devolvemos 0 y la pantalla lo avisa. */
function convMoneda(monto,de,a){
  const d=de==="USD"?"USD":"ARS", h=a==="USD"?"USD":"ARS";
  if(d===h) return monto;
  const r=cotizacion();
  if(!r) return 0;
  return d==="USD" ? monto*r : monto/r;
}
function hayCrucesDeMoneda(){
  return S.transactions.some((t)=>{
    const o=cuentaById(t.cuenta), d=cuentaById(t.cuentaDestino);
    return (o && (o.moneda||"ARS")!==(t.moneda||"ARS")) || (d && (d.moneda||"ARS")!==(t.moneda||"ARS"));
  });
}

/* El saldo de partida es una FOTO: lo que había en la cuenta al cierre del día que puso el
   usuario, con los movimientos de ese día ya adentro. Un movimiento mueve el saldo solo si
   pasó después de esa foto.

   Sin esto, alguien que carga los gastos del día y después crea la cuenta con el saldo que le
   muestra el banco (que ya los descontó) los cuenta dos veces. Pasó de verdad: una cuenta con
   $119.010,87 reales mostraba $347.521,74.

   El mismo día es el caso difícil y lo resuelve el sello de tiempo: un movimiento del día de la
   foto cuenta solo si se cargó DESPUÉS de sacarla. Los movimientos viejos no tienen sello y se
   consideran anteriores, que es lo correcto: la foto ya los incluía. */
/* Una cuenta "desde cero" no tiene foto: su saldo es la suma de TODO lo cargado. La primera
   versión igual guardaba una fecha —el día anterior al movimiento más viejo de ese momento— y
   eso la convertía en una foto disfrazada: bastaba con mover un movimiento a un día anterior
   para que quedara del lado de afuera y desapareciera del saldo, sin tocar el resumen del mes,
   que no mira ninguna cerca. Desde cero es un modo, no una fecha, y no tiene borde.
   El fotoTs===1 con saldo en cero identifica a las que se guardaron con la forma vieja. */
function esDesdeCero(c){
  return !!c && (c.desdeCero===true || (!Number(c.saldoInicial) && Number(c.fotoTs)===1));
}
function posteriorAFoto(t,c){
  if(!c) return false;
  if(esDesdeCero(c)) return true;
  if(!c.desde) return true;
  if(t.fecha>c.desde) return true;
  if(t.fecha<c.desde) return false;
  return !!(t.ts && c.fotoTs && t.ts>c.fotoTs);
}

/* El saldo de una cuenta es su saldo de partida más lo que pasó por ella después de la foto.
   Los ajustes de conciliación son movimientos con monto con signo. */
/* Un gasto y su devolución son DOS movimientos de plata distintos, con fechas distintas:
   pagaste el super el 12 y te devolvieron la mitad el 13. Para el resumen del mes alcanza
   con el neto, porque los dos caen en el mismo mes. Para el saldo de una cuenta no: la
   foto del saldo de partida puede caer justo en el medio, y ahí netear los dos hechos hace
   desaparecer plata que sí entró. Por eso acá el gasto se descuenta entero y cada
   devolución se suma aparte, cada una mirando su propia fecha contra la foto. */
function saldoDeCuenta(id,hasta){
  const c=cuentaById(id);
  if(!c) return 0;
  let s=Number(c.saldoInicial)||0;
  for(const t of S.transactions){
    if(hasta && t.fecha>hasta) continue;
    const post=posteriorAFoto(t,c);
    if(post){
      const m=convMoneda(Number(t.monto)||0,t.moneda,c.moneda);
      if(t.cuenta===id){
        if(t.tipo==="ingreso") s+=m;
        else if(t.tipo==="gasto") s-=m;      /* entero: lo devuelto se suma más abajo */
        else if(t.tipo==="ajuste") s+=m;
        else s-=m;
      }
      if(t.cuentaDestino===id && t.cuenta!==id) s+=m;
    }
    /* La plata devuelta vuelve a la cuenta que pagó. Entra si la devolución es posterior a
       la foto, o si el gasto entero ya lo era (ahí se descontó completo y hay que netearlo). */
    if(t.tipo==="gasto" && t.cuenta===id && (t.reembolsos||[]).length){
      for(const r of t.reembolsos){
        const f=r.fecha||t.fecha;
        if(hasta && f>hasta) continue;
        if(!post && !posteriorAFoto({fecha:f,ts:r.ts},c)) continue;
        s+=convMoneda(Number(r.monto)||0,t.moneda,c.moneda);
      }
    }
  }
  return s;
}

/* Ahorro e inversión que salieron de una cuenta pero no fueron a ninguna:
   la plata sigue siendo tuya, así que el patrimonio la tiene que contar igual. */
function ahorroSinCuenta(hasta){
  const out={ARS:0,USD:0};
  for(const t of S.transactions){
    if(hasta && t.fecha>hasta) continue;
    if((t.tipo==="ahorro"||t.tipo==="inversion") && !t.cuentaDestino){
      /* Si salió de una cuenta y es anterior a su foto, esa plata ya está dentro del saldo
         de partida: sumarla acá la duplicaría en el patrimonio. */
      const origen=cuentaById(t.cuenta);
      if(origen && !posteriorAFoto(t,origen)) continue;
      out[t.moneda==="USD"?"USD":"ARS"]+=Number(t.monto)||0;
    }
  }
  return out;
}

function cotizacion(){ return Number(S.settings.cotizacionUSD)||0; }

/* Moneda en la que se MUESTRAN los saldos (los movimientos se siguen guardando en la
   moneda en la que ocurrieron). Sin cotización no se puede mostrar en dólares. */
function vista(){
  const v = S.settings.monedaVista==="USD" ? "USD" : "ARS";
  return (v==="USD" && !cotizacion()) ? "ARS" : v;
}
function fmtV(monto,desde){ const v=vista(); return formatMoney(convMoneda(monto,desde||"ARS",v),v); }
/* Devuelve el número ya formateado (o sea, el estado final correcto) y, solo cuando
   estamos entrando a una pantalla, lo marca para que suba desde cero. */
function nAnim(monto,desde,fmt){
  const txt = fmt==="short" ? shortV(monto,desde) : fmtV(monto,desde);
  if(!S.entrada || !animOk()) return esc(txt);
  return `<span class="cnt" data-v="${Number(monto)||0}" data-m="${esc(desde||"ARS")}"`
    + ` data-f="${fmt==="short"?"short":"full"}">${esc(txt)}</span>`;
}
function animOk(){
  return !(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
}
function shortV(monto,desde){
  const v=vista(), m=convMoneda(monto,desde||"ARS",v);
  if(v!=="USD") return short$(m);
  const a=Math.abs(m);
  if(a>=1000) return "US$ "+(m/1000).toFixed(1).replace(".",",")+"k";
  return "US$ "+Math.round(m);
}
function diasDesde(iso){
  if(!iso) return null;
  const d=Math.floor((new Date(todayISO())-new Date(iso))/86400000);
  return isNaN(d)?null:Math.max(0,d);
}
/* Una cotización vieja hace que el patrimonio se lea mal sin que se note, así que
   a partir de una semana la marcamos. */
function cotizacionVieja(){ const d=diasDesde(S.settings.cotizacionFecha); return d!==null && d>=7; }
function cotizacionEdad(){
  const d=diasDesde(S.settings.cotizacionFecha);
  if(d===null) return "sin fecha";
  if(d===0) return "cargada hoy";
  if(d===1) return "cargada ayer";
  return `cargada hace ${d} días`;
}
function guardarCotizacion(valor){
  const n=numAR(valor);
  const v = isNaN(n)||n<=0 ? "" : String(n);
  S.settings={...S.settings,cotizacionUSD:v,cotizacionFecha:v?todayISO():""};
  S.cotForm=false;
  persistSettings(); render();
}
function aPesos(ars,usd){ const r=cotizacion(); return ars+(r?usd*r:0); }

function patrimonio(hasta){
  const liq={ARS:0,USD:0}, inv={ARS:0,USD:0};
  cuentasActivas().forEach((c)=>{
    const bag = c.tipo==="inversion" ? inv : liq;
    bag[c.moneda==="USD"?"USD":"ARS"] += saldoDeCuenta(c.id,hasta);
  });
  const sinC=ahorroSinCuenta(hasta);
  inv.ARS+=sinC.ARS; inv.USD+=sinC.USD;
  /* Lo comprado con tarjeta y todavía no pagado es plata que ya no es tuya: resta. */
  const deuda=deudaTarjetas(hasta);
  const usdTotal=liq.USD+inv.USD-deuda.USD;
  const activos=aPesos(liq.ARS+inv.ARS,liq.USD+inv.USD);
  const deudaTotal=aPesos(deuda.ARS,deuda.USD);
  return {liq,inv,sinC,usdTotal,deuda,activos,deudaTotal,
    total:activos-deudaTotal,
    faltaCotizacion: !cotizacion() && (usdTotal!==0 || hayCrucesDeMoneda())};
}

function finDeMes(mk){ return `${mk}-${String(diasEnMes(mk)).padStart(2,"0")}`; }
function patrimonioHistorial(){
  const base=monthKeyOf(todayISO()), out=[];
  for(let i=5;i>=0;i--){
    const mk=shiftMonth(base,-i);
    const p=patrimonio(i===0?todayISO():finDeMes(mk));
    out.push({mes:mk,label:monthShort(mk),total:p.total});
  }
  return out;
}

/* Movimientos ya asignados a la cuenta que caen ANTES de su foto: su plata está adentro
   del saldo de partida y por eso no se vuelve a contar. Si hay muchos, casi siempre es que
   la cuenta se creó DESPUÉS de cargar el mes, y esa configuración es frágil: cualquier dato
   que se agregue más tarde sobre uno de esos movimientos —una devolución, sobre todo— es
   ambiguo, porque la app no puede saber si esa plata ya estaba adentro de la foto o entró
   después. La salida no es adivinar mejor: es que la foto no se superponga con los datos. */
function movsTapadosPorFoto(c){
  if(!c) return [];
  return S.transactions.filter((t)=>(t.cuenta===c.id||t.cuentaDestino===c.id) && !posteriorAFoto(t,c));
}
function diaAnterior(iso){
  const [y,m,d]=String(iso).split("-").map(Number);
  const x=new Date(y,m-1,d-1);
  return `${x.getFullYear()}-${String(x.getMonth()+1).padStart(2,"0")}-${String(x.getDate()).padStart(2,"0")}`;
}
function arranqueDeCuenta(id){
  const f=S.transactions.filter((t)=>t.cuenta===id||t.cuentaDestino===id).map((t)=>t.fecha).sort();
  return f.length ? diaAnterior(f[0]) : diaAnterior(todayISO());
}
/* Pasa la cuenta a "se calcula sola": saldo de partida en cero, con fecha anterior a todo
   lo cargado. Deja de haber foto, y entonces deja de haber ambigüedad. */
function cuentaDesdeCero(id){
  const c=cuentaById(id); if(!c) return;
  const desde=arranqueDeCuenta(id);
  S.cuentas=S.cuentas.map((x)=>x.id===id?{...x,saldoInicial:0,desde,fotoTs:1,desdeCero:true}:x);
  const ajustes=S.transactions.filter((t)=>t.tipo==="ajuste" && t.cuenta===id).length;
  persistCuentas();
  setMessages([...S.messages,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),
    text:`Listo: "${c.nombre}" ahora se calcula sumando todo lo que cargaste, desde cero. `
      + `El saldo de partida dejó de existir, así que ningún movimiento queda tapado.`
      + (ajustes ? ` Ojo: tenés ${ajustes===1?"un ajuste de conciliación":ajustes+" ajustes de conciliación"} `
                 + `de antes, que se hicieron contra el saldo viejo. Revisalos en Actividad: lo más probable `
                 + `es que ya no correspondan y convenga borrarlos.` : "")}]);
  S.concId=id; render();
}

function nuevaCuentaForm(){
  return {id:null,nombre:"",tipo:"liquida",moneda:"ARS",saldoInicial:"",desde:todayISO(),modo:"foto"};
}
function guardarCuenta(){
  const f=S.cuentaForm; if(!f) return;
  const nombre=(f.nombre||"").trim();
  if(!nombre){ showWarn("La cuenta necesita un nombre."); return; }
  const previa=S.cuentas.find((c)=>c.id===f.id);
  const cero = f.modo==="cero";
  const saldoInicial = cero ? 0 : (isNaN(numAR(f.saldoInicial))?0:numAR(f.saldoInicial));
  const desde = cero ? arranqueDeCuenta(f.id||"") : (f.desde||todayISO());
  /* La foto se saca de nuevo solo si cambió el saldo o su fecha: renombrar una cuenta no
     debería volver a descontar lo que ya se cargó. */
  const reFoto = !previa || Number(previa.saldoInicial)!==saldoInicial || previa.desde!==desde;
  const limpia={id:f.id||uid(),nombre,tipo:f.tipo==="inversion"?"inversion":"liquida",
    moneda:f.moneda==="USD"?"USD":"ARS",saldoInicial,desde,desdeCero:cero,
    fotoTs: cero ? 1 : (reFoto ? Date.now() : (previa.fotoTs||Date.now())),
    archivada:previa?!!previa.archivada:false};
  S.cuentas = f.id ? S.cuentas.map((c)=>c.id===f.id?limpia:c) : [...S.cuentas,limpia];
  if(!S.settings.cuentaDefault && limpia.tipo==="liquida"){
    S.settings={...S.settings,cuentaDefault:limpia.id};
    persistSettings();
  }
  S.cuentaForm=null; S.warn="";
  persistCuentas(); render();
}
function borrarCuenta(id){
  const usada=S.transactions.some((t)=>t.cuenta===id||t.cuentaDestino===id);
  if(usada){
    S.cuentas=S.cuentas.map((c)=>c.id===id?{...c,archivada:true}:c);
    showWarn("Esa cuenta tiene movimientos, así que la archivé en lugar de borrarla: los movimientos siguen intactos.");
  } else {
    S.cuentas=S.cuentas.filter((c)=>c.id!==id);
  }
  if(S.settings.cuentaDefault===id){
    const otra=cuentasActivas().find((c)=>c.tipo==="liquida");
    S.settings={...S.settings,cuentaDefault:otra?otra.id:""};
    persistSettings();
  }
  S.cuentaForm=null;
  persistCuentas(); render();
}

/* Conciliación: comparás el saldo calculado con el real y la app anota la diferencia. */
function conciliar(id){
  const c=cuentaById(id); if(!c) return;
  const real=numAR(S.concValor);
  if(!String(S.concValor).trim() || isNaN(real)){ showWarn("No pude leer ese saldo. Escribilo como 119.010,87 o 119010."); return; }
  const calc=saldoDeCuenta(id);
  const dif=Math.round((real-calc)*100)/100;
  S.concId=null; S.concValor=""; S.warn="";
  if(Math.abs(dif)<0.01){
    setMessages([...S.messages,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),
      text:`Concilié "${c.nombre}": el saldo calculado coincide con el real (${formatMoney(calc,c.moneda)}). No hizo falta ningún ajuste.`}]);
    render(); return;
  }
  const tx={id:uid(),ts:Date.now(),fecha:todayISO(),tipo:"ajuste",monto:dif,moneda:c.moneda,
    categoria:"Ajuste de saldo",descripcion:`Conciliación de ${c.nombre}`,
    esCompartido:false,reembolsos:[],cuenta:id,cuentaDestino:null};
  commit([...S.transactions,tx],[...S.messages,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),
    text:`Concilié "${c.nombre}": el saldo real es ${formatMoney(real,c.moneda)} y el calculado era `
      + `${formatMoney(calc,c.moneda)}, así que anoté un ajuste de ${formatMoney(dif,c.moneda)}. `
      + `Si te acordás de qué movimiento faltaba, cargalo y borrá el ajuste.`}]);
  render();
}

/* ===================== gastos fijos ===================== */

function diasEnMes(mk){ const [y,m]=mk.split("-").map(Number); return new Date(y,m,0).getDate(); }
function diaEfectivo(f,mk){ return Math.min(Number(f.dia)||1,diasEnMes(mk)); }
function fechaDeFijo(f,mk){ return `${mk}-${String(diaEfectivo(f,mk)).padStart(2,"0")}`; }
function fijoHecho(f,mk){ return !!(f.hechos && f.hechos[mk]); }

function fijosDelMes(mk){
  return S.fijos.filter((f)=>f.activo!==false)
    .slice().sort((a,b)=>diaEfectivo(a,mk)-diaEfectivo(b,mk));
}
function fijosPendientes(){
  const mk=monthKeyOf(todayISO());
  const hoy=Number(todayISO().slice(8,10));
  return fijosDelMes(mk).filter((f)=>!fijoHecho(f,mk) && diaEfectivo(f,mk)<=hoy);
}
function totalFijos(){
  return S.fijos.filter((f)=>f.activo!==false && f.moneda!=="USD")
    .reduce((a,f)=>a+montoDeFijo(f),0);
}

/* Un fijo de monto variable no se registra a ciegas: se pregunta cuánto fue. El monto que
   llega acá es el que confirmó el usuario; si no hay, se usa la última estimación. */
function registrarFijos(ids,montos){
  const mk=monthKeyOf(todayISO());
  let tx=[...S.transactions];
  const nombres=[];
  ids.forEach((id)=>{
    const f=S.fijos.find((x)=>x.id===id);
    if(!f || fijoHecho(f,mk)) return;
    const monto=(montos&&montos[id]>0)?montos[id]:montoDeFijo(f);
    const nueva=buildTransaction({tipo:"gasto",monto,moneda:f.moneda,categoria:f.categoria,
      descripcion:f.nombre,fecha:fechaDeFijo(f,mk)},S.settings);
    /* Un gasto fijo siempre sale del mismo lado: si la tiene cargada, no hay nada que preguntar. */
    if(f.cuenta && cuentaById(f.cuenta)) nueva.cuenta=f.cuenta;
    tx.push(nueva);
    nombres.push(f.nombre);
    S.fijos=S.fijos.map((x)=>x.id===id?{...x,hechos:{...(x.hechos||{}),[mk]:nueva.id}}:x);
  });
  if(!nombres.length) return;
  persistFijos();
  const texto = nombres.length>1
    ? `Registré ${nombres.length} gastos fijos de este mes: ${nombres.join(", ")}.`
    : `Registré el gasto fijo "${nombres[0]}" de este mes.`;
  commit(tx,[...S.messages,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),text:texto}]);
}

function desmarcarFijo(id){
  const mk=monthKeyOf(todayISO());
  const f=S.fijos.find((x)=>x.id===id);
  if(!f || !fijoHecho(f,mk)) return;
  const txId=f.hechos[mk];
  const hechos={...f.hechos}; delete hechos[mk];
  S.fijos=S.fijos.map((x)=>x.id===id?{...x,hechos}:x);
  persistFijos();
  commit(S.transactions.filter((t)=>t.id!==txId),null);
  render();
}

/* Un gasto que se repite todos los meses no es un gasto suelto, y la diferencia importa:
   el ritmo diario de la proyección sale SOLO de lo suelto. Esto lo pasa de un lado al otro
   sin recargar nada: queda como gasto fijo, marcado como ya hecho este mes —el movimiento
   que ya existe es su registro— y de acá en adelante la app lo va a esperar cada mes. */
function fijoDesdeMovimiento(txId){
  const t=txById(txId);
  if(!t || t.tipo!=="gasto"){ showWarn("Solo un gasto puede repetirse todos los meses."); return; }
  const mk=monthKeyOf(t.fecha);
  if(S.fijos.some((f)=>f.hechos && f.hechos[mk]===t.id)){
    showWarn("Ese movimiento ya está cargado como gasto fijo."); return;
  }
  const dia=Math.min(28,Math.max(1,Number(String(t.fecha).slice(8,10))||1));
  const nombre=(t.descripcion||t.categoria||"Gasto fijo").trim();
  S.fijos=[...S.fijos,{id:uid(),nombre,monto:Math.abs(Number(t.monto)||0),moneda:t.moneda||"ARS",
    categoria:t.categoria,dia,activo:true,cuenta:t.cuenta||null,hechos:{[mk]:t.id}}];
  persistFijos();
  closeEditor();
  setMessages([...S.messages,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),
    text:`Listo: "${nombre}" quedó como gasto fijo de ${formatMoney(t.monto,t.moneda)} el día ${dia} `
      + `de cada mes, y este mes ya figura registrado. Deja de contar como gasto suelto, así que sale del `
      + `ritmo de la proyección, y el mes que viene te lo voy a recordar. Podés cambiarle el monto o el día `
      + `desde Gastos fijos.`}]);
  render();
}

function nuevoFijoForm(){
  return {id:null,nombre:"",monto:"",moneda:"ARS",categoria:S.settings.categoriasGasto[0]||"Otros",
    dia:1,activo:true,variable:false,cuenta:cuentaDefaultValida(S.settings)||""};
}
/* Para un gasto fijo de monto variable, la mejor estimación es lo último que pagaste: no
   depende de ningún supuesto de tipo de cambio ni de inflación, y se corrige sola cada mes. */
function montoDeFijo(f){
  if(!f.variable) return Number(f.monto)||0;
  const meses=Object.keys(f.hechos||{}).sort();
  for(let i=meses.length-1;i>=0;i--){
    const t=txById(f.hechos[meses[i]]);
    if(t) return Math.abs(Number(t.monto)||0);
  }
  return Number(f.monto)||0;
}
function guardarFijo(){
  const f=S.fijoForm; if(!f) return;
  const nombre=(f.nombre||"").trim();
  const m=numAR(f.monto);
  const monto=Math.abs(isNaN(m)?0:m);
  if(!nombre || !monto){ showWarn("Para guardar un gasto fijo necesito un nombre y un monto."); return; }
  const dia=Math.max(1,Math.min(31,Number(f.dia)||1));
  const limpio={id:f.id||uid(),nombre,monto,moneda:f.moneda==="USD"?"USD":"ARS",
    categoria:validateCategoria("gasto",f.categoria,S.settings),dia,activo:f.activo!==false,
    variable:!!f.variable, cuenta:f.cuenta||"",
    hechos:(S.fijos.find((x)=>x.id===f.id)||{}).hechos||{}};
  S.fijos = f.id ? S.fijos.map((x)=>x.id===f.id?limpio:x) : [...S.fijos,limpio];
  S.fijoForm=null; S.warn="";
  persistFijos(); render();
}
function borrarFijo(id){
  S.fijos=S.fijos.filter((x)=>x.id!==id);
  S.fijoForm=null;
  persistFijos(); render();
}

/* ===================== tarjetas y cuotas =====================

   Una tarjeta acá es solo un nombre y dos días del mes. Nunca se pide ni se guarda
   ningún dato de la tarjeta real: ni número, ni titular, ni vencimiento del plástico.
   Es una etiqueta para agrupar consumos, nada más.

   Las cuotas no se guardan como movimientos: se calculan a partir de la compra. Así
   editar la compra corrige todas las cuotas de una, y no quedan movimientos sueltos
   en meses futuros que se puedan borrar por accidente y romper el plan.

   Cuándo es gasto: cada cuota cuenta como gasto del mes en que vence, no el día de la
   compra. Comprar en cuotas no te saca la plata de la cuenta; te la saca el resumen.
   Por eso la compra baja tu patrimonio (te endeudaste) pero no tu saldo del mes.
   Y por eso el pago del resumen es una transferencia y no un gasto: si contara como
   gasto, la misma plata se contaría dos veces (una en las cuotas y otra al pagarlas). */

function tarjetasActivas(){ return S.tarjetas.filter((t)=>!t.archivada); }
function tarjetaById(id){ return S.tarjetas.find((t)=>t.id===id)||null; }
function tarjetaNombre(id){ const t=tarjetaById(id); return t?t.nombre:""; }

function matchTarjeta(nombre){
  if(!nombre) return null;
  const n=normalize(nombre);
  if(!n) return null;
  const exacta=tarjetasActivas().find((t)=>normalize(t.nombre)===n);
  if(exacta) return exacta.id;
  const parcial=tarjetasActivas().find((t)=>{
    const tn=normalize(t.nombre);
    return tn.includes(n)||n.includes(tn);
  });
  return parcial?parcial.id:null;
}

function diaEnMes(mk,dia){ return Math.min(Math.max(1,Number(dia)||1),diasEnMes(mk)); }
function fechaEnMes(mk,dia){ return `${mk}-${String(diaEnMes(mk,dia)).padStart(2,"0")}`; }

/* Un ciclo (un resumen) se identifica por el mes en el que cierra. Si comprás antes
   del cierre entrás en el resumen de este mes; si comprás después, ya entraste en el
   siguiente. */
function cicloDeCompra(tj,fechaISO){
  const mk=monthKeyOf(fechaISO);
  const dia=Number(String(fechaISO).slice(8,10))||1;
  return dia<=diaEnMes(mk,tj.cierre) ? mk : shiftMonth(mk,1);
}
function fechaCierre(tj,ciclo){ return fechaEnMes(ciclo,tj.cierre); }
function fechaVencimiento(tj,ciclo){
  const v=Math.max(1,Math.min(31,Number(tj.vencimiento)||10));
  const c=Math.max(1,Math.min(31,Number(tj.cierre)||1));
  return fechaEnMes(v>c?ciclo:shiftMonth(ciclo,1),v);
}

/* Repartir en cuotas deja resto: 100.000 en 3 no da tres cuotas iguales. El resto va
   en la última, así la suma de las cuotas es exactamente el total de la compra. */
function montoCuota(cp,n){
  const N=Math.max(1,Number(cp.cuotas)||1);
  const total=Math.abs(Number(cp.monto)||0);
  const base=Math.round(total/N*100)/100;
  return n<N ? base : Math.round((total-base*(N-1))*100)/100;
}

function cuotasDeCompra(cp){
  const tj=tarjetaById(cp.tarjeta);
  if(!tj || tj.archivada) return [];
  const N=Math.max(1,Math.min(48,Number(cp.cuotas)||1));
  const ciclo0=cicloDeCompra(tj,cp.fecha||todayISO());
  const out=[];
  for(let n=1;n<=N;n++){
    const ciclo=shiftMonth(ciclo0,n-1);
    out.push({
      id:`cuota:${cp.id}:${n}`,
      fecha:fechaVencimiento(tj,ciclo),
      tipo:"gasto",
      monto:montoCuota(cp,n),
      moneda:cp.moneda==="USD"?"USD":"ARS",
      categoria:cp.categoria,
      descripcion:(cp.descripcion||"Compra")+(N>1?` · cuota ${n}/${N}`:""),
      esCompartido:false, reembolsos:[],
      cuenta:null, cuentaDestino:null,
      virtual:true, compraId:cp.id, tarjeta:cp.tarjeta, ciclo, cuotaN:n, cuotasTotal:N,
    });
  }
  return out;
}

/* Recalcular todas las cuotas en cada render sería tirar trabajo a la basura: se
   recalculan solo cuando cambia una compra o una tarjeta. */
let _cuotasV=0, _cuotasCache=[], _cuotasCacheV=-1;
function invalidarCuotas(){ _cuotasV++; }
function cuotasVirtuales(){
  if(_cuotasCacheV!==_cuotasV){
    _cuotasCache=S.compras.reduce((acc,cp)=>acc.concat(cuotasDeCompra(cp)),[]);
    _cuotasCacheV=_cuotasV;
  }
  return _cuotasCache;
}
/* Todo lo que cuenta como movimiento para las pantallas: lo que cargó el usuario más
   las cuotas calculadas. Lo que se guarda sigue siendo solo S.transactions. */
function movs(){
  const c=cuotasVirtuales();
  return c.length ? S.transactions.concat(c) : S.transactions;
}

function pagoDeCiclo(tj,ciclo){
  const txId=tj.pagos && tj.pagos[ciclo];
  return txId ? (S.transactions.find((t)=>t.id===txId)||null) : null;
}
function cicloPagado(tj,ciclo,hasta){
  const pg=pagoDeCiclo(tj,ciclo);
  if(!pg) return false;
  return hasta ? pg.fecha<=hasta : true;
}
function cuotasDeCiclo(tarjetaId,ciclo){
  return cuotasVirtuales().filter((c)=>c.tarjeta===tarjetaId && c.ciclo===ciclo);
}
function totalCiclo(tarjetaId,ciclo){
  return cuotasDeCiclo(tarjetaId,ciclo).reduce((a,c)=>a+c.monto,0);
}
function ciclosDeTarjeta(id){
  const s=new Set(cuotasVirtuales().filter((c)=>c.tarjeta===id).map((c)=>c.ciclo));
  return [...s].sort();
}
/* El resumen que toca pagar: el más viejo que todavía no se pagó. */
function cicloPendiente(tj){
  const cs=ciclosDeTarjeta(tj.id).filter((c)=>!cicloPagado(tj,c));
  return cs.length?cs[0]:null;
}
/* Resúmenes ya cerrados y sin pagar: lo que de verdad te falta pagar hoy. */
function resumenesPendientes(){
  const hoy=todayISO(), out=[];
  tarjetasActivas().forEach((tj)=>{
    ciclosDeTarjeta(tj.id).forEach((ciclo)=>{
      if(cicloPagado(tj,ciclo)) return;
      if(fechaCierre(tj,ciclo)>hoy) return;
      const total=totalCiclo(tj.id,ciclo);
      if(total>0) out.push({tj,ciclo,total,vence:fechaVencimiento(tj,ciclo)});
    });
  });
  return out.sort((a,b)=>a.vence<b.vence?-1:1);
}
/* Deuda: todo lo comprado que todavía no se pagó. Es un pasivo, resta del patrimonio. */
function deudaTarjetas(hasta){
  const out={ARS:0,USD:0};
  const compraById={};
  S.compras.forEach((cp)=>{ compraById[cp.id]=cp; });
  tarjetasActivas().forEach((tj)=>{
    cuotasVirtuales().forEach((c)=>{
      if(c.tarjeta!==tj.id) return;
      if(cicloPagado(tj,c.ciclo,hasta)) return;
      if(hasta){
        const cp=compraById[c.compraId];
        if(cp && cp.fecha>hasta) return;   /* todavía no la habías comprado */
      }
      out[c.moneda==="USD"?"USD":"ARS"]+=c.monto;
    });
  });
  return out;
}
function hayTarjetas(){ return tarjetasActivas().length>0; }

/* ===================== Proyección ===================== */
/* Proyectar es mezclar tres cosas de naturaleza distinta, y lo importante es no confundirlas:
     · lo que YA pasó, que es un hecho;
     · lo que falta pero está comprometido —cuotas de tarjeta y gastos fijos—, donde se sabe
       la fecha y el monto y no hay nada que adivinar;
     · lo que falta y no se sabe: el gasto suelto del resto del mes, que solo se estima.
   La pantalla las muestra separadas siempre. Una proyección que no deja ver cuánto es dato y
   cuánto es supuesto es una cifra que miente con precisión, que es la peor forma de mentir. */
/* Una compra grande de supermercado no es "por única vez": es grande y espaciada. Marcarla
   como única deja atrás un supuesto falso —que no volvés a comprar comida en lo que queda del
   mes— y vuelve la proyección optimista. Con las semanas que dura, la cuenta se hace bien:
   cubre desde su fecha hasta ahí, y solo los días que quedan descubiertos necesitan otra. */
function diasEntre(a,b){ return Math.round((new Date(b)-new Date(a))/86400000); }
function cubrimiento(t,hoy,finMes){
  const semanas=Number(t.duraSemanas)||0;
  if(semanas<=0) return null;
  const dias=semanas*7;
  const desde=t.fecha;
  const hasta=new Date(new Date(desde).getTime()+dias*86400000).toISOString().slice(0,10);
  /* días de lo que queda del mes que esta compra ya tiene cubiertos */
  const ini = hoy>desde ? hoy : desde;
  const fin = hasta<finMes ? hasta : finMes;
  const cubiertos=Math.max(0,diasEntre(ini,fin));
  return {dias,hasta,cubiertos,porDia:(Number(t.monto)||0)/dias};
}

function idsDeFijos(mk){
  const s=new Set();
  S.fijos.forEach((f)=>{ const id=f.hechos&&f.hechos[mk]; if(id) s.add(id); });
  return s;
}
function proyeccion(mk){
  const hoy=todayISO(), mkHoy=monthKeyOf(hoy);
  const cerrado=mk<mkHoy, futuro=mk>mkHoy;
  const D=diasEnMes(mk);
  const d = cerrado ? D : futuro ? 0 : Number(hoy.slice(8,10));
  const faltan=Math.max(0,D-d);

  const st=computeMonthStats(movs(),mk).ARS;
  const fijosIds=idsDeFijos(mk);

  /* Lo ya cargado se parte en comprometido (cuotas y fijos) y suelto (todo lo demás). */
  const finMes=`${mk}-${String(D).padStart(2,"0")}`;
  let cuotas=0, fijosHechos=0, puntuales=0, duraderos=0, reponer=0;
  const cuotasCat={}, fijosCat={}, puntualCat={}, duraCat={}, reponerCat={};
  const cubiertas=[], corrientes={};
  movs().forEach((t)=>{
    if(monthKeyOf(t.fecha)!==mk || t.tipo!=="gasto" || (t.moneda||"ARS")==="USD") return;
    const n=netoDe(t);
    if(t.virtual){ cuotas+=n; cuotasCat[t.categoria]=(cuotasCat[t.categoria]||0)+n; return; }
    if(fijosIds.has(t.id)){ fijosHechos+=n; fijosCat[t.categoria]=(fijosCat[t.categoria]||0)+n; return; }
    const cub=cerrado||futuro ? null : cubrimiento(t,hoy,finMes);
    if(cub){
      /* Sale del ritmo. La reposición NO se calcula por compra: dos compras semanales
         seguidas son la misma corriente de gasto, y la segunda ya es la reposición de la
         primera — sumar las dos contaría el futuro dos veces. Se agrupan por categoría y
         manda la cobertura que llega más lejos. */
      duraderos+=n; duraCat[t.categoria]=(duraCat[t.categoria]||0)+n;
      const g=corrientes[t.categoria]||(corrientes[t.categoria]={hasta:"",tasas:[],desc:""});
      if(cub.hasta>g.hasta){ g.hasta=cub.hasta; g.desc=t.descripcion||t.categoria; }
      g.tasas.push(cub.porDia*(n/Math.max(1,Number(t.monto)||1)));
      return;
    }
    if(t.puntual){ puntuales+=n; puntualCat[t.categoria]=(puntualCat[t.categoria]||0)+n; }
  });

  /* Cada corriente (una categoría con compras que duran) necesita reponerse solo desde que
     se le acaba la cobertura hasta fin de mes. */
  Object.keys(corrientes).forEach((cat)=>{
    const g=corrientes[cat];
    const tasa=g.tasas.reduce((a,b)=>a+b,0)/g.tasas.length;
    const desde = g.hasta>hoy ? g.hasta : hoy;
    const dias = Math.max(0, diasEntre(desde,finMes));
    const r=tasa*dias;
    reponer+=r; reponerCat[cat]=r;
    cubiertas.push({cat,desc:g.desc,hasta:g.hasta,dias,rep:r});
  });

  /* Los fijos del mes que todavía no se registraron: plata que va a salir sí o sí. */
  const fijosPend=fijosDelMes(mk).filter((f)=>!fijoHecho(f,mk) && (f.moneda||"ARS")!=="USD");
  const fijosFalta=fijosPend.reduce((a,f)=>a+montoDeFijo(f),0);
  const fijosFaltaCat={};
  fijosPend.forEach((f)=>{ fijosFaltaCat[f.categoria]=(fijosFaltaCat[f.categoria]||0)+montoDeFijo(f); });

  /* El ritmo sale SOLO del gasto suelto: meter las cuotas adentro inflaría el promedio
     diario con plata que ya está contada aparte y que no se repite todos los días. */
  const suelto=Math.max(0, st.totalGasto - cuotas - fijosHechos - puntuales - duraderos);
  const ritmo = d>0 ? suelto/d : 0;
  const sueltoFalta = ritmo*faltan + reponer;

  const gastoProy = st.totalGasto + fijosFalta + sueltoFalta;
  const estim=ingresoEstimado();
  /* Si ya entró más de lo estimado, manda lo real; si todavía no, se asume que el resto llega. */
  const ingresoProy = Math.max(st.totalIngreso, estim);
  const dispProy = ingresoProy - gastoProy - st.totalAhorro - st.totalInversion;

  const cats=[];
  const nombres=new Set([...Object.keys(st.gastoPorCategoria),...Object.keys(fijosFaltaCat)]);
  nombres.forEach((c)=>{
    const ya=st.gastoPorCategoria[c]||0;
    const comp=fijosFaltaCat[c]||0;
    const sueltoC=Math.max(0, ya-(cuotasCat[c]||0)-(fijosCat[c]||0)-(puntualCat[c]||0)-(duraCat[c]||0));
    const est=(d>0 ? (sueltoC/d)*faltan : 0) + (reponerCat[c]||0);
    if(ya<=0 && comp<=0) return;
    cats.push({cat:c,ya,comp,est,proy:ya+comp+est,objetivo:montoObjetivo(c,estim)});
  });
  cats.sort((a,b)=>b.proy-a.proy);

  return {mk,D,d,faltan,cerrado,futuro,st,cuotas,fijosHechos,fijosFalta,fijosPend,puntuales,
          duraderos,reponer,cubiertas,
          suelto,ritmo,sueltoFalta,gastoProy,ingresoProy,dispProy,cats,
          tempranito: !cerrado && !futuro && d<5};
}

/* ===================== Alertas ===================== */
/* Ninguna alerta se guarda: todas se calculan del estado cada vez que se dibuja la
   pantalla. Si el problema se resuelve —pagás el resumen, registrás el fijo, baja el
   gasto— la alerta desaparece sola. Así nunca se junta un tablero de avisos viejos
   que ya no significan nada, que es la forma más rápida de que dejes de mirarlos. */
function alertaCfg(){ return {...ALERTAS_DEFAULT,...(S.settings.alertas||{})}; }
function diasHasta(iso){
  if(!iso) return null;
  const d=Math.round((new Date(iso)-new Date(todayISO()))/86400000);
  return isNaN(d)?null:d;
}
function cuandoVence(d){
  if(d<0) return d===-1?"venció ayer":`venció hace ${-d} días`;
  if(d===0) return "vence hoy";
  if(d===1) return "vence mañana";
  return `vence en ${d} días`;
}
function cuandoEra(d){
  if(d<0) return d===-1?"era ayer":`era hace ${-d} días`;
  if(d===0) return "es hoy";
  if(d===1) return "es mañana";
  return `es en ${d} días`;
}
/* El título se escapa al dibujarlo; el detalle es HTML, así que lo que venga del
   usuario se escapa acá adentro. */
function numAl(v,desde){ return `<span class="num">${esc(fmtV(v,desde))}</span>`; }
const NIVEL_ORDEN={urgente:0,aviso:1,info:2};

let _alCache=null;
function invalidarAlertas(){ _alCache=null; }
function alertas(){
  if(_alCache) return _alCache;
  const cfg=alertaCfg(), out=[], hoy=todayISO(), mk=monthKeyOf(hoy);
  const hoyD=Number(hoy.slice(8,10));
  const st=computeMonthStats(movs(),mk).ARS;

  if(cfg.tarjetas){
    /* Resúmenes cerrados y sin pagar, pero solo cuando el vencimiento ya está encima:
       avisar tres semanas antes es ruido. */
    const res=resumenesPendientes().map((r)=>({r,d:diasHasta(r.vence)})).filter((x)=>x.d<=cfg.dias);
    if(res.length>1){
      const total=res.reduce((a,x)=>a+convMoneda(x.r.total,x.r.tj.moneda,"ARS"),0);
      const venc=res.filter((x)=>x.d<0).length;
      out.push({id:"res:varios",nivel:venc?"urgente":"aviso",icono:"tarjeta",
        titulo:`${res.length} resúmenes de tarjeta sin pagar`,
        detalle:`${numAl(total)} en total · ${venc?`${venc} ya ${venc>1?"vencieron":"venció"}`:cuandoVence(res[0].d)}`,
        nav:"tarjetas"});
    } else res.forEach((x)=>{
      out.push({id:`res:${x.r.tj.id}:${x.r.ciclo}`,nivel:x.d<0?"urgente":"aviso",icono:"tarjeta",
        titulo:`Resumen de ${x.r.tj.nombre} sin pagar`,
        detalle:`${numAl(x.r.total,x.r.tj.moneda)} · ${cuandoVence(x.d)}`,
        nav:"tarjetas"});
    });
    /* El cierre cambia en qué resumen cae lo que compres hoy: saberlo un día antes sirve. */
    tarjetasActivas().forEach((tj)=>{
      const ciclo=cicloDeCompra(tj,hoy), d=diasHasta(fechaCierre(tj,ciclo));
      if(d===null||d<0||d>cfg.dias) return;
      out.push({id:`cierre:${tj.id}:${ciclo}`,nivel:"info",icono:"tarjeta",
        titulo:`${tj.nombre} cierra ${d===0?"hoy":d===1?"mañana":`en ${d} días`}`,
        detalle:"Lo que compres después entra en el resumen del mes que viene.",
        nav:"tarjetas"});
    });
  }

  if(cfg.fijos){
    const pend=fijosDelMes(mk).filter((f)=>!fijoHecho(f,mk))
      .map((f)=>({f,d:diaEfectivo(f,mk)-hoyD})).filter((x)=>x.d<=cfg.dias);
    if(pend.length>1){
      const total=pend.reduce((a,x)=>a+convMoneda(montoDeFijo(x.f),x.f.moneda||"ARS","ARS"),0);
      const vencidos=pend.filter((x)=>x.d<0).length;
      out.push({id:"fijo:varios",nivel:vencidos?"aviso":"info",icono:"repetir",
        titulo:`${pend.length} gastos fijos sin registrar`,
        detalle:`${numAl(total)} en total · ${vencidos?`${vencidos} ya ${vencidos>1?"pasaron":"pasó"} de fecha`:"están por vencer"}`,
        nav:"fijos"});
    } else pend.forEach((x)=>{
      out.push({id:`fijo:${x.f.id}`,nivel:x.d<0?"aviso":"info",icono:"repetir",
        titulo:`${x.f.nombre} sin registrar`,
        detalle:`${numAl(montoDeFijo(x.f),x.f.moneda)}${x.f.variable?" aprox.":""} · ${cuandoEra(x.d)}`,
        nav:"fijos"});
    });
  }

  if(cfg.objetivos){
    const estim=ingresoEstimado();
    (S.settings.categoriasGasto||[]).forEach((cat)=>{
      const target=montoObjetivo(cat,estim), actual=st.gastoPorCategoria[cat]||0;
      if(!(target>0)||!(actual>0)) return;
      const pct=actual/target;
      if(pct>=1) out.push({id:`obj:${cat}`,nivel:"aviso",icono:"objetivo",
        titulo:`Te pasaste del objetivo en ${cat}`,
        detalle:`${numAl(actual)} de ${numAl(target)} · ${numAl(actual-target)} de más`,nav:"resumen"});
      else if(pct>=0.85) out.push({id:`obj:${cat}`,nivel:"info",icono:"objetivo",
        titulo:`${cat} está por llegar al objetivo`,
        detalle:`${numAl(actual)} de ${numAl(target)} · te quedan ${numAl(target-actual)}`,nav:"resumen"});
    });
    /* Ahorro e inversión van al revés: la alerta es quedarse corto, y recién sirve
       sobre el final del mes, cuando todavía llegás a hacer algo. */
    const quedan=diasEnMes(mk)-hoyD;
    if(quedan<=5) [["Ahorro",st.totalAhorro],["Inversión",st.totalInversion]].forEach(([cat,actual])=>{
      const target=montoObjetivo(cat,estim);
      if(!(target>0)||actual>=target) return;
      out.push({id:`meta:${cat}`,nivel:"info",icono:"objetivo",
        titulo:`${cat} va por debajo del objetivo`,
        detalle:`${numAl(actual)} de ${numAl(target)} · faltan ${numAl(target-actual)} y ${
          quedan<=0?"se termina el mes":quedan===1?"queda 1 día":`quedan ${quedan} días`}`,nav:"resumen"});
    });
  }

  if(cfg.saldos){
    cuentasActivas().forEach((c)=>{
      const sal=saldoDeCuenta(c.id);
      if(sal>=-0.5) return;
      out.push({id:`saldo:${c.id}`,nivel:"urgente",icono:"banco",
        titulo:`${c.nombre} quedó en negativo`,
        detalle:`${numAl(sal,c.moneda)} según lo que cargaste`,nav:"patrimonio"});
    });
    const disp=disponibleDe(st);
    if(disp<0) out.push({id:"disp",nivel:"aviso",icono:"objetivo",
      titulo:"Gastaste más de lo que entró este mes",
      detalle:`Te pasaste por ${numAl(-disp)}`,nav:"resumen"});
    if(cotizacionVieja() && (vista()==="USD"||hayCrucesDeMoneda()))
      out.push({id:"cotiz",nivel:"info",icono:"banco",titulo:"La cotización del dólar está vieja",
        detalle:`${esc(cotizacionEdad())} · todo lo que ves en dólares sale de ahí`,nav:"patrimonio"});
  }

  _alCache=out.sort((a,b)=>NIVEL_ORDEN[a.nivel]-NIVEL_ORDEN[b.nivel]);
  return _alCache;
}
/* Las "info" son para saber, no para hacer: no cuentan en el contador ni en el punto. */
function alertasActivas(){ return alertas().filter((a)=>a.nivel!=="info"); }
function hayUrgente(){ return alertas().some((a)=>a.nivel==="urgente"); }

function nuevaTarjetaForm(){
  const liq=cuentasActivas().find((c)=>c.tipo!=="inversion");
  return {id:null,nombre:"",cierre:25,vencimiento:5,moneda:"ARS",cuentaPago:liq?liq.id:""};
}
function guardarTarjeta(){
  const f=S.tarjetaForm; if(!f) return;
  const nombre=(f.nombre||"").trim();
  if(!nombre){ showWarn("La tarjeta necesita un nombre para poder identificarla."); return; }
  const previa=S.tarjetas.find((t)=>t.id===f.id);
  const limpia={id:f.id||uid(),nombre,
    cierre:Math.max(1,Math.min(31,Number(f.cierre)||25)),
    vencimiento:Math.max(1,Math.min(31,Number(f.vencimiento)||5)),
    moneda:f.moneda==="USD"?"USD":"ARS",
    cuentaPago:f.cuentaPago||"",
    pagos:previa?(previa.pagos||{}):{},
    archivada:previa?!!previa.archivada:false};
  S.tarjetas = f.id ? S.tarjetas.map((t)=>t.id===f.id?limpia:t) : [...S.tarjetas,limpia];
  S.tarjetaForm=null; S.warn="";
  persistTarjetas(); render();
}
function borrarTarjeta(id){
  const usada=S.compras.some((cp)=>cp.tarjeta===id);
  if(usada){
    S.tarjetas=S.tarjetas.map((t)=>t.id===id?{...t,archivada:true}:t);
    showWarn("Esa tarjeta tiene compras cargadas, así que la archivé en lugar de borrarla.");
  } else {
    S.tarjetas=S.tarjetas.filter((t)=>t.id!==id);
  }
  S.tarjetaForm=null;
  persistTarjetas(); render();
}

function nuevaCompraForm(tarjetaId){
  const tj=tarjetaId?tarjetaById(tarjetaId):tarjetasActivas()[0];
  return {id:null,tarjeta:tj?tj.id:"",descripcion:"",monto:"",moneda:tj?(tj.moneda||"ARS"):"ARS",
    categoria:S.settings.categoriasGasto[0]||"Otros",fecha:todayISO(),cuotas:1};
}
function guardarCompra(){
  const f=S.compraForm; if(!f) return;
  const m=numAR(f.monto);
  const monto=Math.abs(isNaN(m)?0:m);
  if(!f.tarjeta || !monto){ showWarn("Para guardar una compra necesito la tarjeta y el monto."); return; }
  const limpia={id:f.id||uid(),tarjeta:f.tarjeta,
    descripcion:(f.descripcion||"").trim()||"Compra",
    monto,moneda:f.moneda==="USD"?"USD":"ARS",
    categoria:validateCategoria("gasto",f.categoria,S.settings),
    fecha:f.fecha||todayISO(),
    cuotas:Math.max(1,Math.min(48,Number(f.cuotas)||1))};
  S.compras = f.id ? S.compras.map((c)=>c.id===f.id?limpia:c) : [...S.compras,limpia];
  S.compraForm=null; S.warn="";
  persistCompras(); render();
}
function borrarCompra(id){
  S.compras=S.compras.filter((c)=>c.id!==id);
  S.compraForm=null;
  persistCompras(); render();
}

/* El pago del resumen saca la plata de una cuenta y cancela la deuda: por eso es una
   transferencia (neutra para el mes) y no un gasto. El gasto ya se contó en las cuotas. */
function pagarResumen(tarjetaId,ciclo){
  const tj=tarjetaById(tarjetaId); if(!tj) return;
  const total=totalCiclo(tarjetaId,ciclo);
  if(!total){ showWarn("Ese resumen no tiene consumos."); return; }
  const cuenta=S.pagoCuenta || tj.cuentaPago || cuentaDefaultValida(S.settings) || null;
  const tx={id:uid(),ts:Date.now(),fecha:todayISO(),tipo:"transferencia",monto:total,
    moneda:tj.moneda==="USD"?"USD":"ARS",categoria:"Transferencia",
    descripcion:`Pago del resumen · ${tj.nombre}`,
    esCompartido:false,reembolsos:[],cuenta,cuentaDestino:null,
    pagoTarjeta:tarjetaId,ciclo};
  S.tarjetas=S.tarjetas.map((t)=>t.id===tarjetaId?{...t,pagos:{...(t.pagos||{}),[ciclo]:tx.id}}:t);
  S.pagoId=null; S.pagoCuenta=""; S.warn="";
  persistTarjetas();
  const dondeSalio = cuenta && cuentaNombre(cuenta) ? ` desde ${cuentaNombre(cuenta)}` : "";
  commit([...S.transactions,tx],[...S.messages,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),
    text:`Pagué el resumen de ${tj.nombre} de ${monthLabel(ciclo)}: ${formatMoney(total,tx.moneda)}${dondeSalio}. `
      + `No lo conté como gasto del mes porque las cuotas ya se contaron cuando vencieron; lo que hizo fue `
      + `bajarte el saldo de la cuenta y cancelar esa parte de la deuda.`}]);
  render();
}
function desmarcarPago(tarjetaId,ciclo){
  const tj=tarjetaById(tarjetaId); if(!tj) return;
  const txId=tj.pagos && tj.pagos[ciclo];
  const pagos={...(tj.pagos||{})}; delete pagos[ciclo];
  S.tarjetas=S.tarjetas.map((t)=>t.id===tarjetaId?{...t,pagos}:t);
  persistTarjetas();
  if(txId) commit(S.transactions.filter((t)=>t.id!==txId),null);
  render();
}

/* ===================== flujo del chat ===================== */

function handleUndo(withUser){
  if(!S.undoSnapshot){
    setMessages([...withUser,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),
      text:"No tengo nada reciente para deshacer en esta sesión (solo guardo un paso atrás)."}]);
    return;
  }
  const snap=S.undoSnapshot;
  S.undoSnapshot=null;
  S.transactions=snap.transactions;
  setMessages([...withUser,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),
    text:"Deshecho — quedó como estaba antes de la última acción."}]);
  persistTransactions();
  if(snap.compras && JSON.stringify(snap.compras)!==JSON.stringify(S.compras)){
    S.compras=snap.compras;
    persistCompras();
  }
}

async function send(text){
  text=(text||"").trim();
  if(!text||S.isProcessing) return;
  const withUser=[...S.messages,{id:uid(),role:"user",kind:"text",text,ts:Date.now()}];
  S.messages=withUser; S.draft=""; S.isProcessing=true; render();

  if(isUndoCommand(text)){
    S.pendingReembolso=null; handleUndo(withUser);
    S.isProcessing=false; render(); return;
  }

  if(S.pendingReembolso){
    const low=normalize(text);
    if(["cancelar","dejalo","olvidalo","nada"].some((w)=>low===w||low.startsWith(w+" "))){
      S.pendingReembolso=null;
      setMessages([...withUser,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),text:"Listo, no registré nada."}]);
      S.isProcessing=false; render(); return;
    }
    const clar={...S.pendingReembolso,matchHint:`${S.pendingReembolso.matchHint||""} ${text}`.trim()};
    const cands=findReimbursementCandidates(S.transactions,clar);
    if(cands.length===1){
      const r=applyReimbursement(S.transactions,[cands[0].tx.id],clar,S.settings);
      S.pendingReembolso=null;
      commit(r.updatedTransactions,[...withUser,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),text:r.text}]);
    } else if(cands.length>1){
      S.pendingReembolso=null;
      setMessages([...withUser,{id:uid(),role:"assistant",kind:"chooser",mode:"reembolso",parsed:clar,
        candidates:cands.map((c)=>({txId:c.tx.id})),ts:Date.now()}]);
    } else {
      S.pendingReembolso=clar;
      setMessages([...withUser,{id:uid(),role:"assistant",kind:"ask",parsed:clar,ts:Date.now(),
        text:'Sigo sin encontrar ese gasto. Probá con otra palabra (la categoría, o algo de la descripción) — o escribí "cancelar".'}]);
    }
    S.isProcessing=false; render(); return;
  }

  try{
    const parsed=await parseMessageWithAI(text,S.settings);
    if(parsed.tipo==="reembolso"){
      if(!parsed.motivoEspecificado){
        S.pendingReembolso=parsed;
        setMessages([...withUser,{id:uid(),role:"assistant",kind:"ask",parsed,ts:Date.now(),text:reembolsoQuestion(parsed)}]);
      } else if(Array.isArray(parsed.conceptos) && parsed.conceptos.length>1){
        /* Una devolución que toca más de un gasto SIEMPRE se muestra antes de aplicarse, con
           el reparto propuesto y los montos editables. Antes se aplicaba sola, llenando el
           primer gasto hasta el tope: eso inventaba un reparto y lo presentaba como un hecho,
           y de paso desajustaba el objetivo de las dos categorías involucradas. */
        setMessages([...withUser,mensajeReparto(parsed)]);
      } else {
        const cands=findReimbursementCandidates(S.transactions,parsed);
        if(cands.length===1){
          const r=applyReimbursement(S.transactions,[cands[0].tx.id],parsed,S.settings);
          commit(r.updatedTransactions,[...withUser,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),text:r.text}]);
        } else if(cands.length>1){
          setMessages([...withUser,{id:uid(),role:"assistant",kind:"chooser",mode:"reembolso",parsed,
            candidates:cands.map((c)=>({txId:c.tx.id})),ts:Date.now()}]);
        } else {
          S.pendingReembolso=parsed;
          setMessages([...withUser,{id:uid(),role:"assistant",kind:"ask",parsed,ts:Date.now(),
            text:"No encontré un gasto que coincida con eso. "+reembolsoQuestion(parsed)}]);
        }
      }
    } else if(parsed.tipo==="correccion"){
      const cands=findCorrectionCandidates(S.transactions,parsed);
      if(cands.length===1){
        const r=applyCorrection(S.transactions,cands[0].tx.id,parsed,S.settings);
        commit(r.updatedTransactions,[...withUser,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),text:r.text}]);
      } else if(cands.length>1){
        setMessages([...withUser,{id:uid(),role:"assistant",kind:"chooser",mode:"correccion",parsed,
          candidates:cands.map((c)=>({txId:c.tx.id})),ts:Date.now()}]);
      } else {
        setMessages([...withUser,{id:uid(),role:"assistant",kind:"error",ts:Date.now(),
          text:"No encontré ese movimiento entre los de este mes. Los cambios por chat solo alcanzan al mes en curso — si es más viejo, corregilo a mano tocando el lápiz en Resumen."}]);
      }
    } else if(parsed.tipo==="pagotarjeta"){
      const tjId=matchTarjeta(parsed.tarjeta);
      const tj=tjId?tarjetaById(tjId):null;
      const ciclo=tj?cicloPendiente(tj):null;
      if(!tj){
        setMessages([...withUser,{id:uid(),role:"assistant",kind:"error",ts:Date.now(),
          text:"No reconocí esa tarjeta. Cargala primero en Tarjetas y cuotas y volvé a decírmelo."}]);
      } else if(!ciclo){
        setMessages([...withUser,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),
          text:`No tenés resúmenes pendientes de ${tj.nombre}, así que no registré nada.`}]);
      } else {
        S.messages=withUser;
        S.pagoCuenta=matchCuenta(parsed.cuenta)||tj.cuentaPago||"";
        pagarResumen(tj.id,ciclo);
      }
    } else if(parsed.tipo==="gasto" && matchTarjeta(parsed.tarjeta)){
      /* Una compra con tarjeta no es un movimiento suelto: es una compra que genera
         cuotas. Por eso va a S.compras y no a la lista de movimientos. */
      const tjId=matchTarjeta(parsed.tarjeta);
      const tj=tarjetaById(tjId);
      const cuotas=Math.max(1,Math.min(48,Number(parsed.cuotas)||1));
      const cp={id:uid(),tarjeta:tjId,
        descripcion:parsed.descripcion||"Compra",
        monto:Math.abs(Number(parsed.monto)||0),
        moneda:parsed.moneda==="USD"?"USD":"ARS",
        categoria:validateCategoria("gasto",parsed.categoria,S.settings),
        fecha:fechaValida(parsed.fecha),cuotas};
      S.undoSnapshot={transactions:S.transactions,compras:S.compras};
      S.compras=[...S.compras,cp];
      persistCompras();
      const cs=cuotasDeCompra(cp);
      const texto = cuotas>1
        ? `Compra registrada con ${tj.nombre}: ${formatMoney(cp.monto,cp.moneda)} — ${cp.categoria}`
          + (cp.descripcion?` (${cp.descripcion})`:"")
          + `. La dividí en ${cuotas} cuotas de ${formatMoney(montoCuota(cp,1),cp.moneda)}: la primera cae en `
          + `${monthLabel(monthKeyOf(cs[0].fecha))} y la última en ${monthLabel(monthKeyOf(cs[cs.length-1].fecha))}. `
          + `Cada cuota cuenta como gasto del mes en que vence.`
        : `Compra registrada con ${tj.nombre}: ${formatMoney(cp.monto,cp.moneda)} — ${cp.categoria}`
          + (cp.descripcion?` (${cp.descripcion})`:"")
          + `. Entra en el resumen que vence el ${formatFecha(cs[0].fecha)}, así que cuenta como gasto de `
          + `${monthLabel(monthKeyOf(cs[0].fecha))}.`;
      setMessages([...withUser,{id:uid(),role:"assistant",kind:"text",ts:Date.now(),text:texto},
        ...avisoFecha(parsed)]);
    } else {
      const modo=S.settings.preguntarCuenta||"faltante";
      /* Con una sola cuenta no hay nada que elegir: se la ponemos y listo. */
      const usarDefault = modo!=="faltante" || cuentasActivas().length<=1;
      const tx=buildTransaction(parsed,S.settings,usarDefault);
      const pedir=slotsAPreguntar(tx,modo);
      const msg={id:uid(),role:"assistant",kind:"confirm",txId:tx.id,ts:Date.now(),
        text:buildConfirmText(tx),pedir};
      commit([...S.transactions,tx],[...withUser,msg,...avisoFecha(parsed)]);
      if(parsed.confianza==="baja") openEditor(tx.id,msg.id);
    }
  }catch(e){
    setMessages([...withUser,{id:uid(),role:"assistant",kind:"error",ts:Date.now(),text:aiErrorText(e)}]);
  }finally{
    S.isProcessing=false; render();
  }
}

function txById(id){ return S.transactions.find((t)=>t.id===id); }

function openEditor(txId,msgId){
  const tx=txById(txId); if(!tx) return;
  S.editingId=msgId||("tx:"+txId);
  S.editForm={...tx,reembolsos:[...(tx.reembolsos||[])]};
}
function closeEditor(){ S.editingId=null; S.editForm=null; }

function saveEditor(){
  const f=S.editForm; if(!f) return;
  const crudo = numAR(f.monto);
  const monto = f.tipo==="ajuste" ? (isNaN(crudo)?0:crudo) : Math.abs(isNaN(crudo)?0:crudo);
  /* La fecha puede moverse dentro de su propio mes. Cambiarla de mes movería el movimiento
     de un resumen a otro sin que se vea, así que si queda fuera se deja la que tenía. */
  const previa=(txById(f.id)||{}).fecha||f.fecha;
  const fecha=fechaEnRango(f.fecha,monthKeyOf(previa)) ? f.fecha : previa;
  const upd={...f,monto,fecha,categoria:validateCategoria(f.tipo,f.categoria,S.settings),
    cuenta:f.cuenta||null,cuentaDestino:(f.cuentaDestino&&f.cuentaDestino!==f.cuenta)?f.cuentaDestino:null};
  const newTx=S.transactions.map((t)=>t.id===upd.id?{...t,...upd}:t);
  const newMsgs=S.messages.map((m)=>(m.kind==="confirm"&&m.txId===upd.id)?{...m,text:buildConfirmText(upd)}:m);
  closeEditor();
  commit(newTx,newMsgs);
  render();
}
function deleteTx(txId){
  const newTx=S.transactions.filter((t)=>t.id!==txId);
  const newMsgs=S.messages.map((m)=>(m.kind==="confirm"&&m.txId===txId)
    ? {id:m.id,role:"assistant",kind:"text",ts:Date.now(),text:"Movimiento eliminado."} : m);
  closeEditor();
  commit(newTx,newMsgs);
  render();
}

/* Asignar la cuenta NO pisa el punto de deshacer: si lo hiciera, "deshacé el último
   movimiento" volvería al estado de después de crearlo y el movimiento quedaría ahí. */
function asignarCuenta(msgId,k,cuentaId){
  const msg=S.messages.find((m)=>m.id===msgId); if(!msg) return;
  const tx=txById(msg.txId); if(!tx) return;
  const upd={...tx,[k]:cuentaId||null};
  if(k==="cuenta" && upd.cuentaDestino===upd.cuenta) upd.cuentaDestino=null;
  S.transactions=S.transactions.map((t)=>t.id===tx.id?upd:t);
  persistTransactions();
  const quedan=(msg.pedir||[]).filter((p)=>p!==k).filter((p)=>opcionesDeSlot(upd,p).length>0);
  setMessages(S.messages.map((m)=>m.id===msgId
    ?{...m,pedir:quedan,text:buildConfirmText(upd)}:m));
  render();
}
function omitirCuenta(msgId){
  setMessages(S.messages.map((m)=>m.id===msgId?{...m,pedir:[],omitido:true}:m));
  render();
}

function resolveChooser(msgId,txId){
  const msg=S.messages.find((m)=>m.id===msgId); if(!msg) return;
  if(msg.mode==="correccion"){
    if(txId){
      const r=applyCorrection(S.transactions,txId,msg.parsed,S.settings);
      commit(r.updatedTransactions,S.messages.map((m)=>m.id===msgId
        ?{id:m.id,role:"assistant",kind:"text",ts:Date.now(),text:r.text}:m));
    } else {
      setMessages(S.messages.map((m)=>m.id===msgId
        ?{id:m.id,role:"assistant",kind:"text",ts:Date.now(),text:"Ok, no corrijo nada — si querés, editalo a mano desde Resumen."}:m));
    }
  } else if(txId){
    const r=applyReimbursement(S.transactions,[txId],msg.parsed,S.settings);
    commit(r.updatedTransactions,S.messages.map((m)=>m.id===msgId
      ?{id:m.id,role:"assistant",kind:"text",ts:Date.now(),text:r.text}:m));
  } else {
    S.pendingReembolso=msg.parsed;
    setMessages(S.messages.map((m)=>m.id===msgId
      ?{id:m.id,role:"assistant",kind:"ask",parsed:msg.parsed,ts:Date.now(),text:reembolsoQuestion(msg.parsed)}:m));
  }
  render();
}

function confirmMulti(msgId){
  const msg=S.messages.find((m)=>m.id===msgId); if(!msg) return;
  const asign=msg.filas.filter((f)=>f.txId && Number(f.monto)>0)
    .map((f)=>({txId:f.txId,monto:Number(f.monto)||0}));
  const sinGasto=msg.filas.filter((f)=>!f.txId).length;
  const r=applyReimbursementMontos(S.transactions,asign,msg.parsed,S.settings);
  const text=sinGasto>0
    ? `${r.text} (${sinGasto===1?"Un concepto no lo encontré cargado":sinGasto+" conceptos no los encontré cargados"} como gasto — si en realidad los habías gastado, cargalos y avisame de nuevo.)`
    : r.text;
  commit(r.updatedTransactions,S.messages.map((m)=>m.id===msgId
    ?{id:m.id,role:"assistant",kind:"text",ts:Date.now(),text}:m));
  render();
}

