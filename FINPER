    </div>
  </div>`);

  p.push(`<div class="stack" style="gap:10px">
    <h2 class="h" style="font-size:16px;margin:0">Datos</h2>
    <div class="chips" style="padding:0">
      <button class="chip" data-act="csv">Exportar CSV</button>
      <button class="chip danger" data-act="reset">Borrar todos los datos</button>
    </div>
    <div class="tiny muted">Tus movimientos se guardan en tu cuenta, atados a esta app. Solo los ves vos.</div>
  </div>`);

  p.push(`</div>`);
  $view.innerHTML=p.join("");
}

